# Vorlage für die lokale .env (NICHT committen — .env steht in .gitignore).
# Echte Werte stehen im Supabase-Dashboard (Project Settings → API) bzw. bei Resend.

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Geheim! Umgeht alle Zugriffsregeln der Datenbank. Nur lokal für Skripte, nie im Repository,
# nie in eine App oder Webseite einbauen.
SUPABASE_SERVICE_ROLE_KEY=

EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Geheim! Versand von E-Mails (Edge Functions lesen ihn aus den Supabase-Secrets).
RESEND_API_KEY=
