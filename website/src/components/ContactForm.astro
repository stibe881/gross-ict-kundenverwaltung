---
// Kontaktformular → Supabase Edge Function contact-form → Lead im CRM.
interface Props {
  theme?: "dark" | "light";
  heading?: string;
  intro?: string;
  messageLabel?: string;
}
const {
  theme = "dark",
  heading = "Projekt anfragen",
  intro = "Erzählen Sie uns kurz, was Sie vorhaben — Sie erhalten innert eines Arbeitstags eine persönliche Antwort von Stefan Gross.",
  messageLabel = "Ihr Vorhaben",
} = Astro.props;
const uid = theme;
---
<div class={`contact-card ${theme === "light" ? "light form-light" : ""}`} id="kontakt">
  <div>
    <p class="mono" style="margin-bottom: 10px">Kontakt</p>
    <h2 class="section-title">{heading}</h2>
    <p class={`intro ${theme === "light" ? "on-light" : ""}`}>{intro}</p>
    <address class="contact-address">
      <span><strong>Telefon</strong> <a href="tel:+41415623416">+41 41 562 34 16</a></span>
      <span><strong>E-Mail</strong> <a href="mailto:info@gross-ict.ch">info@gross-ict.ch</a></span>
      <span><strong>Adresse</strong> Neuhushof 3, 6144 Zell LU</span>
    </address>
  </div>
  <form class="contact-form" method="post" novalidate>
    <div class="two">
      <div>
        <label for={`cf-name-${uid}`}>Name *</label>
        <input id={`cf-name-${uid}`} name="name" type="text" required autocomplete="name" />
      </div>
      <div>
        <label for={`cf-email-${uid}`}>E-Mail *</label>
        <input id={`cf-email-${uid}`} name="email" type="email" required autocomplete="email" />
      </div>
      <div>
        <label for={`cf-phone-${uid}`}>Telefon</label>
        <input id={`cf-phone-${uid}`} name="phone" type="tel" autocomplete="tel" />
      </div>
      <div>
        <label for={`cf-company-${uid}`}>Firma</label>
        <input id={`cf-company-${uid}`} name="company" type="text" autocomplete="organization" />
      </div>
    </div>
    <div style="margin-top: 12px">
      <label for={`cf-msg-${uid}`}>{messageLabel}</label>
      <textarea id={`cf-msg-${uid}`} name="message" rows="4"></textarea>
    </div>
    <!-- Honeypot: für Menschen unsichtbar, Bots füllen es aus -->
    <div class="hp-field" aria-hidden="true">
      <label for={`cf-web-${uid}`}>Website</label>
      <input id={`cf-web-${uid}`} name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <button type="submit" class="btn btn-gold" style="width: 100%; margin-top: 16px">Anfrage senden</button>
    <p class="form-status" role="status" aria-live="polite"></p>
    <p class="form-fine">
      Ihre Anfrage landet direkt in unserem System — keine Sammel-Postfächer, keine Umwege.
      Hinweise zum Datenschutz finden Sie in der <a href="/datenschutz">Datenschutzerklärung</a>.
    </p>
  </form>
</div>

<style>
  .contact-card {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 44px;
    padding: 44px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 16px;
  }
  .contact-card.light, html.area-ict .contact-card {
    background: #FFFFFF;
    border-color: #E6EAF0;
    box-shadow: 0 22px 44px rgba(16,42,80,0.1);
    color: var(--ict-ink);
  }
  .contact-card.light .section-title, html.area-ict .contact-card .section-title { color: var(--ict-ink); }
  @media (max-width: 860px) {
    .contact-card { grid-template-columns: 1fr; padding: 28px; }
  }
  .intro { color: var(--muted); font-size: 15px; max-width: 420px; margin-top: 8px; }
  .intro.on-light, html.area-ict .intro { color: var(--ict-muted); }
  .contact-address {
    font-style: normal;
    margin-top: 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14.5px;
  }
  .contact-address strong { display: inline-block; width: 72px; font-weight: 700; }
  .hp-field { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .form-status { margin-top: 10px; font-size: 14px; font-weight: 600; min-height: 20px; }
  .form-status.ok { color: #4ADE80; }
  .form-status.err { color: #F87171; }
  .contact-card.light .form-status.ok, html.area-ict .contact-card .form-status.ok { color: #2E6B3F; }
  .contact-card.light .form-status.err, html.area-ict .contact-card .form-status.err { color: #A33A2A; }
  .form-fine { font-size: 11.5px; margin-top: 8px; color: var(--faint); }
  .contact-card.light .form-fine, html.area-ict .contact-card .form-fine { color: var(--ict-muted); }
</style>

<script>
  const FUNCTION_URL = "https://bvluvvyvftygnxtmboxw.supabase.co/functions/v1/contact-form";

  document.querySelectorAll<HTMLFormElement>(".contact-form").forEach((form) => {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const status = form.querySelector<HTMLElement>(".form-status")!;
      const btn = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
      const data = Object.fromEntries(new FormData(form).entries());

      if (!data.name || !data.email) {
        status.textContent = "Bitte Name und E-Mail ausfüllen.";
        status.className = "form-status err";
        return;
      }

      btn.disabled = true;
      status.textContent = "Wird gesendet…";
      status.className = "form-status";
      try {
        const res = await fetch(FUNCTION_URL, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        const out = await res.json().catch(() => ({}));
        if (!res.ok || out.error) throw new Error(out.error || "Senden fehlgeschlagen");
        status.textContent = "Vielen Dank! Wir melden uns innert eines Arbeitstags.";
        status.className = "form-status ok";
        form.reset();
      } catch (err) {
        status.textContent = "Senden fehlgeschlagen — rufen Sie uns gerne an: +41 41 562 34 16.";
        status.className = "form-status err";
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
