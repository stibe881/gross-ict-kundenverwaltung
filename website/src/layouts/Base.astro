---
import "../styles/fonts.css";
import "../styles/global.css";
import { GA_MEASUREMENT_ID } from "../config";
const gaId = GA_MEASUREMENT_ID.trim();

interface Props {
  title: string;
  description?: string;
  active?: string;
  noChrome?: boolean;
  theme?: "dark" | "light";
  overlayHeader?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title,
  description = "Gross ICT, Zell LU — Web- und Appdesign zum Festpreis ab CHF 1'500 und ICT Services ohne Warteschlange für die Zentralschweiz.",
  active = "",
  noChrome = false,
  theme = "dark",
  overlayHeader = false,
  jsonLd = [],
} = Astro.props;

// Kanonische Adresse (ohne .html, ohne Slash am Ende) — verhindert, dass
// www-/Nicht-www- oder .html-Varianten als Duplikate gewertet werden.
const SITE = "https://gross-ict.ch";
const pfad = Astro.url.pathname.replace(/(^|\/)index(\.html)?$/, "$1").replace(/\.html$/, "").replace(/\/+$/, "");
const canonical = SITE + (pfad || "/");
const ogImage = SITE + "/img/og-gross-ict.jpg";

// Strukturierte Daten für Suchmaschinen und KI-Assistenten: wer die Firma
// ist, wo sie sitzt, wann sie erreichbar ist und was sie anbietet.
const organisation = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["LocalBusiness", "ProfessionalService"],
      "@id": SITE + "/#firma",
      name: "Gross ICT",
      url: SITE + "/",
      logo: SITE + "/assets/logo.webp",
      image: ogImage,
      description: "Web- und Appdesign sowie ICT Services (IT-Support, Netzwerk, Sicherheit, Cloud) für Unternehmen, Vereine und Privatpersonen in der Zentralschweiz.",
      telephone: "+41 41 562 34 16",
      email: "info@gross-ict.ch",
      identifier: "CHE-142.161.164",
      founder: { "@type": "Person", name: "Stefan Gross" },
      address: {
        "@type": "PostalAddress",
        streetAddress: "Neuhushof 3",
        postalCode: "6144",
        addressLocality: "Zell",
        addressRegion: "LU",
        addressCountry: "CH",
      },
      areaServed: { "@type": "AdministrativeArea", name: "Zentralschweiz" },
      openingHoursSpecification: [{
        "@type": "OpeningHoursSpecification",
        dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        opens: "08:00",
        closes: "17:30",
      }],
      knowsLanguage: "de-CH",
    },
    { "@type": "WebSite", "@id": SITE + "/#website", url: SITE + "/", name: "Gross ICT", inLanguage: "de-CH", publisher: { "@id": SITE + "/#firma" } },
  ],
};
const jsonLdListe = [organisation, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])];
const headerClass = ["site-header", theme === "light" ? "light" : "", overlayHeader ? "overlay" : ""].filter(Boolean).join(" ");

// Öffentlicher Anon-Key (nur Lesezugriff gemäss RLS)
const supaKey = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJ2bHV2dnl2ZnR5Z254dG1ib3h3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzAyMzU1NTQsImV4cCI6MjA4NTgxMTU1NH0.sw1wb1pLj9Ne-ZoGbQcR6mA5yDHe2PZbImEzt76lP-o';
const partnersUrl = 'https://bvluvvyvftygnxtmboxw.supabase.co/rest/v1/marketing_settings?key=eq.website_partners&select=value';

// Build-Zeit-Stand als Fallback; der Browser lädt die aktuelle Liste nach
// (siehe Script beim Marquee), damit neue Partner ohne Redeploy erscheinen.
let partners = [];
try {
  const res = await fetch(partnersUrl, {
    headers: { 'apikey': supaKey, 'Authorization': `Bearer ${supaKey}` }
  });
  const data = await res.json();
  if (data && data[0] && data[0].value) {
    partners = JSON.parse(data[0].value);
  }
} catch(e) {
  console.error(e);
}
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Gross ICT" />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={canonical} />
    {jsonLdListe.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="preload" href="/fonts/anton-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/sora-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
    {gaId && (
      <script is:inline define:vars={{ gaId }}>
        // Google Analytics mit Einwilligung (Consent Mode v2): Standardmässig
        // ist alles verweigert, und das Google-Skript wird erst NACH «Zulassen»
        // geladen — vorher geht keine Anfrage an Google.
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('consent', 'default', {
          analytics_storage: 'denied', ad_storage: 'denied',
          ad_user_data: 'denied', ad_personalization: 'denied',
        });
        window.gtag('js', new Date());
        window.gaLaden = function () {
          if (window.gaGeladen) return;
          window.gaGeladen = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(s);
          window.gtag('config', gaId, { anonymize_ip: true });
        };
        try {
          if (localStorage.getItem('analyticsConsent') === 'granted') {
            window.gtag('consent', 'update', { analytics_storage: 'granted' });
            window.gaLaden();
          }
        } catch (e) {}
      </script>
    )}
    <script is:inline>
      // Läuft synchron beim Parsen des Head — garantiert vor dem ersten Bild:
      // versteckt die Hero-Texte (html.js) und fängt das pagereveal-Ereignis
      // ab, bevor das gebündelte Modul-Script überhaupt geladen ist.
      document.documentElement.classList.add('js');
      window.__heroReveal = null;
      window.addEventListener('pagereveal', function (e) { window.__heroReveal = e; }, { once: true });
    </script>
    <script>
      document.documentElement.classList.add('js');
      let area = sessionStorage.getItem('area');
      const p = window.location.pathname;
      if (p.includes('webdesign') || p.includes('rechner') || p.includes('referenzen-webdesign')) area = 'webdesign';
      else if (p.includes('ict') || p.includes('referenzen-ict')) area = 'ict';
      if (!area) area = 'webdesign'; // Default Fallback, falls jemand direkt auf /kontakt geht
      
      sessionStorage.setItem('area', area);
      document.documentElement.classList.add('area-' + area);
        // Logo-Ziel: auf den Bereichs-Startseiten führt das Logo zur
        // Farbwelten-Auswahl (/), überall sonst zur jeweiligen Bereichs-Startseite.
        const aufBereichsStart = /\/(webdesign|ict-services)(\.html)?\/?$/.test(window.location.pathname);
        const targetUrl = aufBereichsStart ? '/' : (area === 'ict' ? '/ict-services' : '/webdesign');
        document.addEventListener('DOMContentLoaded', () => document.querySelectorAll('a.dynamic-logo-link').forEach(link => link.href = targetUrl));
    </script>
    <style is:global>
      html.area-webdesign #nav-webdesign { display: none !important; }
      html.area-webdesign #nav-ref-ict { display: none !important; }
      html.area-webdesign #nav-about-ict, html.area-webdesign #foot-about-ict { display: none !important; }
      
      html.area-ict #nav-ict { display: none !important; }
      html.area-ict #nav-ref-webdesign { display: none !important; }
      html.area-ict #nav-about-webdesign, html.area-ict #foot-about-webdesign { display: none !important; }
      html.area-ict #nav-rechner { display: none !important; }

      .partners-marquee {
        overflow: hidden;
        white-space: nowrap;
        background: #F4F7FC; /* Heller Hintergrund für ICT/Default */
        border-top: 1px solid #E6EAF0;
        border-bottom: 1px solid #E6EAF0;
        padding: 44px 0;
        display: flex;
      }
      .partners-marquee[hidden] { display: none; }
      /* Keine tote Lücke zwischen Laufband und Footer
         (~ statt +, weil dazwischen ein script-Element liegt) */
      .partners-marquee ~ .site-footer { margin-top: 0; }
      .partners-track {
        display: flex;
        align-items: center;
        animation: scroll-partners 30s linear infinite;
      }
      /* Hochgeladene Logos sind Bilddateien mit eigenem Hintergrund in allen
         Grössen — darum einheitliche weisse Karten statt Filter-Spielereien. */
      .partners-track img {
        height: 92px;
        width: 210px;
        object-fit: contain;
        background: #fff;
        border-radius: 14px;
        padding: 16px 26px;
        box-sizing: border-box;
        margin-right: 44px;
        border: 1px solid #E3E8F0;
        transition: transform 0.25s ease;
      }
      .partners-track img:hover {
        transform: translateY(-3px);
      }
      @keyframes scroll-partners {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }

      /* Dunkler Webdesign-Bereich: Karten leicht abgesetzt, ohne Rahmen */
      html.area-webdesign .partners-marquee,
      :root[data-theme="overlay"] .partners-marquee {
        background: var(--bg);
        border-top: 1px solid var(--line);
      }
      html.area-webdesign .partners-track img,
      :root[data-theme="overlay"] .partners-track img {
        border-color: transparent;
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    {!noChrome && (
      <header class={headerClass}>
        <div class="inner">
          <a href="/" class="dynamic-logo-link" aria-label="Zur Startseite">
            <img class="brand-logo" src="/assets/logo.webp" alt="Gross ICT" />
          </a>
          <button class="nav-toggle" type="button" aria-label="Menü öffnen" aria-expanded="false" aria-controls="site-nav">
            <span></span><span></span><span></span>
          </button>
          <nav class="site-nav" id="site-nav" aria-label="Hauptnavigation">
            <a id="nav-webdesign" href="/webdesign">Web- &amp; Appdesign</a>
            <a id="nav-ict" href="/ict-services">ICT Services</a>
            <a id="nav-ref-webdesign" href="/referenzen-webdesign" aria-current={active === "referenzen-webdesign" ? "page" : undefined}>Referenzen</a>
            <a id="nav-ref-ict" href="/referenzen-ict" aria-current={active === "referenzen-ict" ? "page" : undefined}>Referenzen</a>
            <a id="nav-rechner" href="/rechner" aria-current={active === "rechner" ? "page" : undefined}>Preisrechner</a>
            <a href="/support" aria-current={active === "support" ? "page" : undefined}>Support</a>
            <a href="/kontakt" aria-current={active === "kontakt" ? "page" : undefined}>Kontakt</a>
            <a id="nav-about-webdesign" href="/wer-wir-sind-webdesign" aria-current={active === "wer-wir-sind-webdesign" ? "page" : undefined}>Wer wir sind</a>
            <a id="nav-about-ict" href="/wer-wir-sind-ict" aria-current={active === "wer-wir-sind-ict" ? "page" : undefined}>Wer wir sind</a>
            <a class="btn-login" href="https://portal.gross-ict.ch">Kunden-Login</a>
          </nav>
        </div>
      </header>
    )}
    <main id="main">
      <slot />
    </main>

    {!noChrome && (
      <div class="partners-marquee" id="partners-marquee" hidden>
        <div class="partners-track" id="partners-track"></div>
      </div>
    )}
    {!noChrome && (
      <script is:inline define:vars={{ initialPartners: partners, supaKey, partnersUrl }}>
        (() => {
          const marquee = document.getElementById("partners-marquee");
          const track = document.getElementById("partners-track");
          if (!marquee || !track) return;
          // Bereich erst beim Rendern bestimmen: das Bereichs-Script läuft als
          // Astro-Modul erst nach diesem Inline-Script, darum zusätzlich über
          // Pfad und sessionStorage absichern. Partner ohne Bereich erscheinen überall.
          const getArea = () => {
            const cl = document.documentElement.classList;
            if (cl.contains("area-ict")) return "ict";
            if (cl.contains("area-webdesign")) return "web";
            if (window.location.pathname.includes("ict")) return "ict";
            try { if (sessionStorage.getItem("area") === "ict") return "ict"; } catch (e) {}
            return "web";
          };

          const render = (list) => {
            const area = getArea();
            const logos = (list || []).filter((p) => p && p.logoUrl && (!p.bereich || p.bereich === area));
            if (!logos.length) { marquee.hidden = true; return; }
            // Inhalt so oft wiederholen, dass die Endlosschleife (translateX -50%)
            // auch bei wenigen Logos nahtlos und ohne Lücke läuft.
            let reps = 2;
            while (logos.length * 220 * reps < window.innerWidth * 2) reps += 2;
            track.innerHTML = "";
            for (let r = 0; r < reps; r++) {
              logos.forEach((p) => {
                const img = document.createElement("img");
                img.src = p.logoUrl;
                img.alt = p.name || "";
                img.title = p.name || "";
                if (r > 0) img.setAttribute("aria-hidden", "true");
                track.appendChild(img);
              });
            }
            marquee.hidden = false;
          };

          render(initialPartners);
          // Aktuelle Liste nachladen, damit CRM-Änderungen ohne Redeploy erscheinen
          fetch(partnersUrl, { headers: { apikey: supaKey, Authorization: "Bearer " + supaKey } })
            .then((r) => r.json())
            .then((d) => { if (d && d[0] && d[0].value) render(JSON.parse(d[0].value)); })
            .catch(() => {});
        })();
      </script>
    )}

    {!noChrome && (
      gaId ? (
        <div class="cookie-note" id="cookie-note" data-analytics hidden role="dialog" aria-label="Statistik-Einwilligung">
          <p>
            <strong>Statistik, wenn Sie möchten.</strong> Wir würden gerne anonymisierte
            Besucherstatistiken mit Google Analytics erfassen, um die Webseite zu verbessern —
            nur mit Ihrer Einwilligung.
            <a href="/datenschutz">Mehr dazu</a>
          </p>
          <div class="cookie-actions">
            <button type="button" id="cookie-ok">Zulassen</button>
            <button type="button" id="cookie-no" class="ghost">Ablehnen</button>
          </div>
        </div>
      ) : (
        <div class="cookie-note" id="cookie-note" hidden>
          <p>
            <strong>Ohne Tracking unterwegs.</strong> Diese Webseite setzt keine
            Tracking-Cookies — gespeichert wird nur technisch Nötiges.
            <a href="/datenschutz">Mehr dazu</a>
          </p>
          <button type="button" id="cookie-ok">Alles klar</button>
        </div>
      )
    )}

    {!noChrome && (
      <footer class="site-footer">
        <div class="container inner">
          <div>
            <a href="/" class="dynamic-logo-link" aria-label="Zur Startseite"><img class="brand-logo" src="/assets/logo.webp" alt="Gross ICT" /></a>
            <p class="fine" style="margin-top: 10px">Web- &amp; Appdesign und ICT Services für die Zentralschweiz</p>
            <p class="fine" style="margin-top: 4px">Neuhushof 3, 6144 Zell · <a href="tel:+41415623416">+41 41 562 34 16</a> · <a href="mailto:info@gross-ict.ch">info@gross-ict.ch</a></p>
          </div>
          <div class="legal">
            <a href="/impressum">Impressum</a>
            <a id="foot-about-webdesign" href="/wer-wir-sind-webdesign">Wer wir sind</a>
            <a id="foot-about-ict" href="/wer-wir-sind-ict">Wer wir sind</a>
            <a href="/datenschutz">Datenschutz</a>
            {gaId && <a href="#cookie-einstellungen" id="cookie-settings">Cookie-Einstellungen</a>}
            <a href="/barrierefreiheit">Barrierefreiheit</a>
          </div>
          <p class="fine">© {new Date().getFullYear()} Gross ICT, Zell LU</p>
        </div>
      </footer>
    )}
    <script>
      // Mobile: Burger-Menü auf- und zuklappen
      const navToggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
      const siteNav = document.getElementById("site-nav");
      if (navToggle && siteNav) {
        navToggle.addEventListener("click", () => {
          const open = siteNav.classList.toggle("open");
          navToggle.setAttribute("aria-expanded", String(open));
          navToggle.setAttribute("aria-label", open ? "Menü schliessen" : "Menü öffnen");
        });
        siteNav.querySelectorAll("a").forEach((a) =>
          a.addEventListener("click", () => {
            siteNav.classList.remove("open");
            navToggle.setAttribute("aria-expanded", "false");
          })
        );
      }

      // Berg-Kulisse: auf Seiten mit Vollbild-Hero (dort ist der Berg schon
      // gross im Bild) erst beim Herunterscrollen weich einblenden —
      // und beim Hochscrollen wieder aus.
      // Nur Seiten mit Vollbild-Foto-Hero (hero-bg) — der Rechner hat z.B.
      // auch eine .hero-Sektion, aber ohne Bergbild.
      const kulisseHeroBg = document.querySelector<HTMLElement>(".hero .hero-bg");
      const kulisseHero = kulisseHeroBg ? (kulisseHeroBg.closest(".hero") as HTMLElement) : null;
      if (kulisseHero) {
        // Höchstens ein Update pro Frame, und nur schreiben, wenn sich der
        // Wert wirklich ändert — sonst invalidiert jedes Scroll-Ereignis die
        // Styles und das Scrollen stockt auf dem Smartphone. Die Variable
        // liegt auf body (nicht html), damit möglichst wenig neu berechnet
        // werden muss; body::before erbt sie von dort.
        let kulisseWert = "";
        let kulisseGeplant = false;
        const updateKulisse = () => {
          kulisseGeplant = false;
          const start = kulisseHero.offsetHeight * 0.55;
          const range = window.innerHeight * 0.9;
          const o = Math.min(1, Math.max(0, (window.scrollY - start) / range)).toFixed(2);
          if (o !== kulisseWert) {
            kulisseWert = o;
            document.body.style.setProperty("--kulisse-opacity", o);
          }
        };
        const kulisseAnfordern = () => {
          if (!kulisseGeplant) {
            kulisseGeplant = true;
            requestAnimationFrame(updateKulisse);
          }
        };
        updateKulisse();
        window.addEventListener("scroll", kulisseAnfordern, { passive: true });
        window.addEventListener("resize", kulisseAnfordern, { passive: true });
      }

      // Dezenter Hinweis statt Cookie-Banner (die Seite setzt keine Cookies);
      // Bestätigung bleibt im lokalen Speicher, damit er nicht wiederkommt.
      const cookieNote = document.getElementById("cookie-note");
      const cookieOk = document.getElementById("cookie-ok");
      const cookieNo = document.getElementById("cookie-no");
      if (cookieNote && cookieOk) {
        const analytics = cookieNote.hasAttribute("data-analytics");
        const w = window as any;
        if (analytics) {
          // Einwilligung für Google Analytics: erst «Zulassen» lädt das Skript,
          // «Ablehnen» (oder keine Antwort) bedeutet: nichts geht an Google.
          let antwort: string | null = null;
          try { antwort = localStorage.getItem("analyticsConsent"); } catch (e) {}
          if (!antwort) cookieNote.hidden = false;
          const speichern = (wert: "granted" | "denied") => {
            try { localStorage.setItem("analyticsConsent", wert); } catch (e) {}
            if (wert === "granted") {
              w.gtag?.("consent", "update", { analytics_storage: "granted" });
              w.gaLaden?.();
            } else {
              w.gtag?.("consent", "update", { analytics_storage: "denied" });
              // Bereits gesetzte Google-Cookies (_ga, _ga_*) entfernen
              const host = location.hostname;
              document.cookie.split(";").map((c) => c.split("=")[0].trim()).filter((n) => n === "_ga" || n.startsWith("_ga_")).forEach((n) => {
                ["", host, "." + host].forEach((d) => {
                  document.cookie = n + "=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/" + (d ? "; domain=" + d : "");
                });
              });
            }
            cookieNote.hidden = true;
          };
          cookieOk.addEventListener("click", () => speichern("granted"));
          cookieNo?.addEventListener("click", () => speichern("denied"));
          document.getElementById("cookie-settings")?.addEventListener("click", (e) => {
            e.preventDefault();
            cookieNote.hidden = false;
          });
        } else {
          let seen = false;
          try { seen = localStorage.getItem("cookieHinweisOk") === "1"; } catch (e) {}
          if (!seen) cookieNote.hidden = false;
          cookieOk.addEventListener("click", () => {
            try { localStorage.setItem("cookieHinweisOk", "1"); } catch (e) {}
            cookieNote.hidden = true;
          });
        }
      }

      // Startsignal für die Hero-Einblendung: `pagereveal` feuert exakt beim
      // ersten tatsächlich dargestellten Frame — `pageshow` dagegen schon
      // beim Laden, also teils bevor irgendetwas sichtbar ist. Startet der
      // Fade zu früh, läuft er unsichtbar ab und der Schriftzug «ploppt».
      let heroGestartet = false;
      const heroAnimStarten = (sofort: boolean) => {
        heroGestartet = true;
        const wurzel = document.documentElement;
        if (sofort && !wurzel.classList.contains("hero-anim")) {
          wurzel.classList.add("hero-anim");
          return;
        }
        wurzel.classList.remove("hero-anim");
        requestAnimationFrame(() => requestAnimationFrame(() => {
          setTimeout(() => wurzel.classList.add("hero-anim"), 120);
        }));
      };
      const hatPagereveal = "onpagereveal" in window;
      const mitReveal = (e: any) => {
        if (e.viewTransition) {
          // Während des Berg-Morphs liegt der Berg-Schnappschuss ÜBER der
          // Seite und verdeckt den Hero-Text — ein früher gestarteter Fade
          // liefe unsichtbar ab und der Text «ploppte» am Ende des Morphs.
          // Darum erst starten, wenn die View Transition abgeschlossen ist.
          e.viewTransition.finished.then(
            () => heroAnimStarten(true),
            () => heroAnimStarten(true)
          );
        } else {
          heroAnimStarten(true);
        }
      };
      const verpasst = (window as any).__heroReveal;
      if (verpasst) {
        mitReveal(verpasst);
      } else if (hatPagereveal) {
        window.addEventListener("pagereveal", mitReveal, { once: true });
      }
      window.addEventListener("pageshow", (e) => {
        // Auffangnetz nur ohne pagereveal-Unterstützung (Firefox) — der
        // Head-Fänger garantiert sonst, dass pagereveal nicht verpasst wird.
        // Nach Rückkehr aus dem BFCache den Fade erneut abspielen.
        if ((!hatPagereveal && !heroGestartet) || e.persisted) heroAnimStarten(false);
      });

      // Scroll-Reveal für [data-reveal]-Elemente
      const els = document.querySelectorAll("[data-reveal]");
      if ("IntersectionObserver" in window && els.length) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add("revealed"); io.unobserve(e.target); }
          });
        }, { rootMargin: "0px 0px -60px 0px", threshold: 0.1 });
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("revealed"));
      }
    </script>
  </body>
</html>
