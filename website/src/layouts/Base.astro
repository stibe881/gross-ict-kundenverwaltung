---
import "../styles/fonts.css";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  active?: string;
  noChrome?: boolean;
  theme?: "dark" | "light";
  overlayHeader?: boolean;
}
const {
  title,
  description = "Gross ICT, Zell LU — Web- und Appdesign zum Festpreis ab CHF 1'500 und ICT Services ohne Warteschlange für die Zentralschweiz.",
  active = "",
  noChrome = false,
  theme = "dark",
  overlayHeader = false,
} = Astro.props;
const headerClass = ["site-header", theme === "light" ? "light" : "", overlayHeader ? "overlay" : ""].filter(Boolean).join(" ");

let partners = [];
try {
  const res = await fetch('https://bvluvvyvftygnxtmboxw.supabase.co/rest/v1/marketing_settings?key=eq.website_partners&select=value', {
    headers: {
      'apikey': 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJ2bHV2dnl2ZnR5Z254dG1ib3h3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzAyMzU1NTQsImV4cCI6MjA4NTgxMTU1NH0.sw1wb1pLj9Ne-ZoGbQcR6mA5yDHe2PZbImEzt76lP-o',
      'Authorization': 'Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJ2bHV2dnl2ZnR5Z254dG1ib3h3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzAyMzU1NTQsImV4cCI6MjA4NTgxMTU1NH0.sw1wb1pLj9Ne-ZoGbQcR6mA5yDHe2PZbImEzt76lP-o'
    }
  });
  const data = await res.json();
  if (data && data[0] && data[0].value) {
    partners = JSON.parse(data[0].value);
  }
} catch(e) {
  console.error(e);
}
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="preload" href="/fonts/anton-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/sora-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script>
      let area = sessionStorage.getItem('area');
      const p = window.location.pathname;
      if (p.includes('webdesign') || p.includes('rechner') || p.includes('referenzen-webdesign')) area = 'webdesign';
      else if (p.includes('ict') || p.includes('referenzen-ict')) area = 'ict';
      if (!area) area = 'webdesign'; // Default Fallback, falls jemand direkt auf /kontakt geht
      
      sessionStorage.setItem('area', area);
      document.documentElement.classList.add('area-' + area);
        const targetUrl = area === 'ict' ? '/ict-services' : '/webdesign';
        document.addEventListener('DOMContentLoaded', () => document.querySelectorAll('a.dynamic-logo-link').forEach(link => link.href = targetUrl));
    </script>
    <style>
      html.area-webdesign #nav-webdesign { display: none !important; }
      html.area-webdesign #nav-ref-ict { display: none !important; }
      
      html.area-ict #nav-ict { display: none !important; }
      html.area-ict #nav-ref-webdesign { display: none !important; }
      html.area-ict #nav-rechner { display: none !important; }

      .partners-marquee {
        overflow: hidden;
        white-space: nowrap;
        background: #F4F7FC; /* Heller Hintergrund für ICT/Default */
        padding: 40px 0;
        display: flex;
      }
      .partners-track {
        display: flex;
        gap: 80px;
        align-items: center;
        animation: scroll-partners 30s linear infinite;
        padding-left: 80px; /* Offset to prevent jump */
      }
      .partners-track img {
        height: 45px;
        object-fit: contain;
        filter: grayscale(100%) opacity(0.5);
        transition: all 0.3s;
      }
      .partners-track img:hover {
        filter: grayscale(0%) opacity(1);
      }
      @keyframes scroll-partners {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }
      
      /* Anpassung für dunkle Themes / Webdesign Bereich */
      html.area-webdesign .partners-marquee, 
      :root[data-theme="overlay"] .partners-marquee { 
        background: var(--bg); 
        border-top: 1px solid var(--line);
      }
      html.area-webdesign .partners-track img,
      :root[data-theme="overlay"] .partners-track img { 
        filter: grayscale(100%) brightness(2) opacity(0.4); 
      }
      html.area-webdesign .partners-track img:hover,
      :root[data-theme="overlay"] .partners-track img:hover { 
        filter: grayscale(0%) brightness(1) opacity(1); 
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    {!noChrome && (
      <header class={headerClass}>
        <div class="inner">
          <a href="/" class="dynamic-logo-link" aria-label="Zur Startseite">
            <img class="brand-logo" src="/assets/logo.webp" alt="Gross ICT" />
          </a>
          <button class="nav-toggle" type="button" aria-label="Menü öffnen" aria-expanded="false" aria-controls="site-nav">
            <span></span><span></span><span></span>
          </button>
          <nav class="site-nav" id="site-nav" aria-label="Hauptnavigation">
            <a id="nav-webdesign" href="/webdesign">Web- &amp; Appdesign</a>
            <a id="nav-ict" href="/ict-services">ICT Services</a>
            <a id="nav-ref-webdesign" href="/referenzen-webdesign" aria-current={active === "referenzen-webdesign" ? "page" : undefined}>Referenzen</a>
            <a id="nav-ref-ict" href="/referenzen-ict" aria-current={active === "referenzen-ict" ? "page" : undefined}>Referenzen</a>
            <a id="nav-rechner" href="/rechner" aria-current={active === "rechner" ? "page" : undefined}>Preisrechner</a>
            <a href="/support" aria-current={active === "support" ? "page" : undefined}>Support</a>
            <a href="/kontakt" aria-current={active === "kontakt" ? "page" : undefined}>Kontakt</a>
            <a class="btn-login" href="https://portal.gross-ict.ch">Kunden-Login</a>
          </nav>
        </div>
      </header>
    )}
    <main id="main">
      <slot />
    </main>

    {!noChrome && partners.length > 0 && (
      <div class="partners-marquee">
        <div class="partners-track">
          {partners.map(p => <img src={p.logoUrl} alt={p.name} title={p.name} />)}
          {partners.map(p => <img src={p.logoUrl} alt={p.name} title={p.name} aria-hidden="true" />)}
        </div>
      </div>
    )}

    {!noChrome && (
      <footer class="site-footer">
        <div class="container inner">
          <div>
            <a href="/" class="dynamic-logo-link" aria-label="Zur Startseite"><img class="brand-logo" src="/assets/logo.webp" alt="Gross ICT" /></a>
            <p class="fine" style="margin-top: 10px">Web- &amp; Appdesign und ICT Services für die Zentralschweiz</p>
            <p class="fine" style="margin-top: 4px">Neuhushof 3, 6144 Zell · <a href="tel:+41415623416">+41 41 562 34 16</a> · <a href="mailto:info@gross-ict.ch">info@gross-ict.ch</a></p>
          </div>
          <div class="legal">
            <a href="/impressum">Impressum</a>
            <a href="/datenschutz">Datenschutz</a>
            <a href="/barrierefreiheit">Barrierefreiheit</a>
          </div>
          <p class="fine">© {new Date().getFullYear()} Gross ICT, Zell LU</p>
        </div>
      </footer>
    )}
    <script>
      // Mobile: Burger-Menü auf- und zuklappen
      const navToggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
      const siteNav = document.getElementById("site-nav");
      if (navToggle && siteNav) {
        navToggle.addEventListener("click", () => {
          const open = siteNav.classList.toggle("open");
          navToggle.setAttribute("aria-expanded", String(open));
          navToggle.setAttribute("aria-label", open ? "Menü schliessen" : "Menü öffnen");
        });
        siteNav.querySelectorAll("a").forEach((a) =>
          a.addEventListener("click", () => {
            siteNav.classList.remove("open");
            navToggle.setAttribute("aria-expanded", "false");
          })
        );
      }

      // Scroll-Reveal für [data-reveal]-Elemente
      const els = document.querySelectorAll("[data-reveal]");
      if ("IntersectionObserver" in window && els.length) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add("revealed"); io.unobserve(e.target); }
          });
        }, { rootMargin: "0px 0px -60px 0px", threshold: 0.1 });
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("revealed"));
      }
    </script>
  </body>
</html>
