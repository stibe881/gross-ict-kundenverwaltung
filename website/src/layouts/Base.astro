---
import "../styles/fonts.css";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  active?: string;
  noCta?: boolean;
  ctaHref?: string;
}
const {
  title,
  description = "Gross ICT, Zell LU — Webseiten zum Festpreis ab CHF 1'500 und IT-Betreuung ohne Warteschlange für die Zentralschweiz.",
  active = "",
  noCta = false,
  ctaHref = "/webdesign#kontakt",
} = Astro.props;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <header class="site-header">
      <div class="inner">
        <a class="brand" href="/">Gross ICT</a>
        <nav class="site-nav" aria-label="Hauptnavigation">
          <a href="/webdesign" aria-current={active === "webdesign" ? "page" : undefined}>Webdesign</a>
          <a href="/ict-services" aria-current={active === "ict" ? "page" : undefined}>ICT Services</a>
          <a href="/rechner" aria-current={active === "rechner" ? "page" : undefined}>Preisrechner</a>
          <a class="btn-login" href="https://portal.gross-ict.ch">Kunden-Login</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    {!noCta && (
      <section class="cta-band">
        <div class="container">
          <span class="mono acid">(Kontakt)</span>
          <a class="cta-link" href={ctaHref}>Projekt anfragen <span class="arrow">↗</span></a>
          <p class="cta-sub">
            Oder direkt: <a href="tel:+41415623416">+41 41 562 34 16</a> ·
            <a href="mailto:info@gross-ict.ch">info@gross-ict.ch</a> — Antwort innert eines Arbeitstags.
          </p>
        </div>
      </section>
    )}
    <footer class="site-footer">
      <div class="container inner">
        <div>
          <a class="brand" href="/" style="font-size: 15px">Gross ICT</a>
          <p class="fine" style="margin-top: 10px">Webseiten &amp; ICT — Neuhushof 3, 6144 Zell LU</p>
          <p class="fine" style="margin-top: 2px"><a href="tel:+41415623416">+41 41 562 34 16</a> · <a href="mailto:info@gross-ict.ch">info@gross-ict.ch</a></p>
        </div>
        <div class="legal">
          <a href="/impressum">Impressum</a>
          <a href="/datenschutz">Datenschutz</a>
          <a href="/barrierefreiheit">Barrierefreiheit</a>
        </div>
        <p class="fine">© {new Date().getFullYear()} Gross ICT, Zell LU</p>
      </div>
    </footer>
  </body>
</html>
