---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
---
<Base
  title="ICT Services — Gross ICT | IT-Betreuung ohne Warteschlange"
  description="IT-Support, Cloud, Cyber-Sicherheit, Netzwerk und Server für KMU in der Zentralschweiz — persönlich und vor Ort."
  active="ict"
  overlayHeader
>
  <div class="ict-page">
    <!-- Vollbild-Hero: Sonnenaufgang am Gipfel (gleicher Aufbau wie Webbereich) -->
    <section class="hero">
      <img class="hero-bg" src="/img/umgebung/ict-gipfel.webp" alt="" />
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="hero-bottom-shade" aria-hidden="true"></div>
      <div class="hero-text">
        <p class="anton hero-kicker">ICT Services mit</p>
        <h1 class="anton hero-big">Weitblick</h1>
      </div>
      <div class="hero-scroll">
        <a href="#leistungen" aria-label="Zu den Leistungen scrollen">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#2A1D12" stroke-width="2.4" aria-hidden="true"><path d="M3 6l5 5 5-5"/></svg>
        </a>
        <span>LEISTUNGEN</span>
      </div>
    </section>

    <!-- Einstieg (ehemaliger Hero-Text) -->
    <section class="intro" id="leistungen">
      <div class="container">
        <p class="kicker">ICT SERVICES · ZENTRALSCHWEIZ</p>
        <h2 class="intro-title">Ihre Zukunft mit verlässlicher ICT</h2>
        <p class="lead">
          Massgeschneiderte IT-Dienstleistungen für Ihr Unternehmen: Cloud-Lösungen,
          IT-Sicherheit, Netzwerktechnik und Betreuung ohne Warteschlange.
        </p>
        <a class="btn btn-gold" href="#kontakt">Kontaktieren Sie uns</a>
      </div>
    </section>

    <!-- Leistungs-Karten -->
    <section class="cards-wrap">
      <div class="container cards">
        <article class="scard" data-reveal>
          <div class="icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#17457A" stroke-width="2"><path d="M17.5 19a4.5 4.5 0 0 0 .4-9A6.5 6.5 0 0 0 5.2 8.6 4.2 4.2 0 0 0 6 19h11.5Z"/></svg>
          </div>
          <h2>Cloud Computing</h2>
          <p>Microsoft 365, Datenablage und Zusammenarbeit in der Cloud — sauber eingerichtet und sicher betrieben.</p>
          <a href="#kontakt">Mehr erfahren →</a>
        </article>
        <article class="scard" data-reveal>
          <div class="icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#17457A" stroke-width="2"><path d="M12 2 4 5.5v6.5c0 5 3.4 9.3 8 10.9 4.6-1.6 8-5.9 8-10.9V5.5L12 2Z"/><path d="M8.8 12.2l2.3 2.3 4.2-4.6"/></svg>
          </div>
          <h2>Cyber-Sicherheit</h2>
          <p>Firewall, Virenschutz, Updates und Sensibilisierung — damit ein Klick nicht zum Schaden wird.</p>
          <a href="#kontakt">Mehr erfahren →</a>
        </article>
        <article class="scard" data-reveal>
          <div class="icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#17457A" stroke-width="2"><rect x="3" y="3" width="18" height="7" rx="2"/><rect x="3" y="14" width="18" height="7" rx="2"/><path d="M7 6.5h.01M7 17.5h.01"/></svg>
          </div>
          <h2>Managed IT-Services</h2>
          <p>Monatlicher Fixpreis, definierte Reaktionszeiten, Wartung inklusive — Ihre IT läuft, wir kümmern uns.</p>
          <a href="#kontakt">Mehr erfahren →</a>
        </article>
      </div>
    </section>

    <!-- Weitere Leistungen -->
    <section class="more">
      <div class="container">
        <h2 class="more-title">Alles aus einer Hand</h2>
        <div class="more-grid">
          <article class="mcard" data-reveal>
            <h3>IT-Support &amp; Helpdesk</h3>
            <p>Sie erreichen direkt die Person, die Ihr Problem löst — per Telefon, Fernwartung oder bei Ihnen im Betrieb. Keine Warteschlange, keine Ticketnummer-Odyssee.</p>
          </article>
          <article class="mcard" data-reveal>
            <h3>Netzwerk &amp; WLAN</h3>
            <p>Planung und Umsetzung für ganze Gebäude: stabile Verkabelung, flächendeckendes WLAN und sauber getrennte Netze für Gäste und Betrieb.</p>
          </article>
          <article class="mcard" data-reveal>
            <h3>Server &amp; Storage</h3>
            <p>Lokal, Cloud oder hybrid — inklusive durchdachter Backup-Strategie, damit Ihre Daten auch im Ernstfall sicher sind.</p>
          </article>
          <article class="mcard" data-reveal>
            <h3>Geräte &amp; Lizenzen</h3>
            <p>Beschaffung, Einrichtung und Verwaltung von Arbeitsplätzen, Mobilgeräten und Software-Lizenzen — dokumentiert im Kundenportal.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Support-Vertrag -->
    <section class="vertrag-wrap" id="vertrag">
      <div class="container vertrag">
        <div>
          <p class="vkicker">SUPPORT-VERTRAG</p>
          <h2>Sorglos-IT mit garantierten Reaktionszeiten</h2>
          <p class="vtext">
            Monatlicher Fixpreis, definierte SLA, Wartung und Updates inklusive — und im
            <a href="https://portal.gross-ict.ch">Kundenportal</a> sehen Sie Tickets,
            Rechnungen und Verträge jederzeit online.
          </p>
        </div>
        <a class="btn btn-gold" href="#kontakt">Beratung anfragen</a>
      </div>
    </section>

    <div style="text-align: center; margin-top: 64px; margin-bottom: 64px;" data-reveal>
      <h2 class="anton" style="font-size: 32px; margin-bottom: 16px;">Unsere Projekte</h2>
      <p style="color: var(--muted); margin-bottom: 24px;">Sehen Sie sich an, wie wir andere Unternehmen bei ihrer IT-Infrastruktur unterstützt haben.</p>
      <a class="btn btn-outline" style="border-color: var(--ict-ink); color: var(--ict-ink);" onmouseover="this.style.background='var(--ict-ink)'; this.style.color='#fff';" onmouseout="this.style.background='transparent'; this.style.color='var(--ict-ink)';" href="/referenzen-ict">Alle ICT-Referenzen ansehen</a>
    </div>

    <!-- Kontakt -->
    <section class="contact-wrap">
      <div class="container">
        <ContactForm
          theme="light"
          heading="Support anfragen"
          intro="Brennt es gerade, rufen Sie direkt an — sonst beschreiben Sie kurz Ihr Anliegen, und Sie hören innert eines Arbeitstags von uns."
          messageLabel="Ihr Anliegen"
        />
      </div>
    </section>
  </div>
</Base>

<style>
  /* Hintergrund transparent, damit die fixe Gipfel-Kulisse (body::before)
     beim Herunterscrollen durchscheint — die helle Farbe kommt vom body. */
  .ict-page { background: transparent; color: var(--ict-ink); margin-bottom: -84px; padding-bottom: 84px; }

  /* Vollbild-Hero wie im Webbereich; Verlauf endet im hellen ICT-Hintergrund */
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    overflow: hidden;
    background: #140E0A;
  }
  .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 900px) {
    .hero-bg { object-position: 62% center; }
  }
  .hero-shade {
    position: absolute; inset: 0;
    background: linear-gradient(100deg, rgba(14,9,6,0.62) 0%, rgba(14,9,6,0.30) 48%, rgba(14,9,6,0.04) 100%);
  }
  .hero-bottom-shade {
    position: absolute; left: 0; right: 0; bottom: 0; height: 52vh;
    background: linear-gradient(180deg, rgba(245,247,250,0) 0%, rgba(245,247,250,0.35) 55%, #F5F7FA 100%);
  }
  .hero-text {
    position: absolute;
    left: clamp(44px, 28vw, 420px);
    top: 50%;
    transform: translateY(-55%);
    padding-right: 24px;
  }
  .hero-kicker { font-size: clamp(22px, 3.2vw, 46px); letter-spacing: 1.5px; color: #F2E8D8; text-shadow: 0 2px 16px rgba(0,0,0,0.45); margin: 0; }
  .hero-big { font-size: clamp(64px, 11.5vw, 168px); letter-spacing: 2px; color: #FFD79A; text-shadow: 0 4px 26px rgba(0,0,0,0.5); margin: 6px 0 0; }
  .hero-scroll {
    position: absolute;
    left: clamp(44px, 28vw, 420px);
    bottom: 58px;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .hero-scroll a {
    display: flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 50%;
    background: #F6F1E7;
    box-shadow: 0 6px 18px rgba(0,0,0,0.25);
  }
  .hero-scroll a:hover { background: #fff; }
  .hero-scroll span {
    font-family: "Sora", sans-serif;
    font-size: 13px; font-weight: 700; letter-spacing: 2.5px;
    color: #4A5468;
  }

  .kicker { margin: 0; font-family: "Sora", sans-serif; font-size: 12.5px; font-weight: 800; letter-spacing: 3px; color: var(--gold); }
  .intro { padding: 72px 0 0; }
  .intro-title {
    margin: 18px 0 0;
    font-size: clamp(32px, 4.6vw, 52px);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: 1px;
    color: var(--ict-ink);
    text-transform: uppercase;
    max-width: 720px;
  }
  .lead { margin: 20px 0 0; font-size: 17px; line-height: 1.65; color: var(--ict-muted); max-width: 540px; }
  .intro .btn { margin-top: 30px; }

  .cards-wrap { position: relative; margin-top: 56px; }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  @media (max-width: 920px) { .cards { grid-template-columns: 1fr; } }
  .scard {
    background: #FFFFFF;
    border-radius: 16px;
    padding: 30px 28px;
    box-shadow: 0 22px 44px rgba(16,42,80,0.16);
  }
  .scard .icon {
    width: 52px; height: 52px; border-radius: 13px; background: #E8F1FB;
    display: flex; align-items: center; justify-content: center;
  }
  .scard h2 { margin: 18px 0 0; font-size: 16px; font-weight: 800; letter-spacing: 1.5px; color: var(--ict-ink); text-transform: uppercase; }
  .scard p { margin: 10px 0 0; font-size: 13.5px; line-height: 1.65; color: var(--ict-muted); }
  .scard a { display: inline-block; margin-top: 14px; font-size: 13px; font-weight: 800; color: #B57F3C; }
  .scard a:hover { color: #96652A; text-decoration: none; }

  .more { padding: 72px 0 0; }
  .more-title { font-size: clamp(24px, 3.4vw, 32px); font-weight: 800; color: var(--ict-ink); }
  .more-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 26px; }
  @media (max-width: 760px) { .more-grid { grid-template-columns: 1fr; } }
  .mcard { background: #FFFFFF; border: 1px solid #E6EAF0; border-radius: 14px; padding: 26px; }
  .mcard h3 { font-size: 17px; color: var(--ict-ink); }
  .mcard p { margin-top: 8px; font-size: 14px; line-height: 1.65; color: var(--ict-muted); }

  .vertrag-wrap { margin-top: 72px; background: var(--grad-ict); }
  .vertrag {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
    padding-top: 44px;
    padding-bottom: 48px;
  }
  .vkicker { margin: 0; font-family: "Sora", sans-serif; font-size: 12px; font-weight: 800; letter-spacing: 3px; color: var(--cyan); }
  .vertrag h2 { margin: 10px 0 0; font-size: clamp(22px, 3vw, 28px); font-weight: 800; color: #fff; }
  .vtext { margin: 10px 0 0; font-size: 14.5px; color: rgba(255,255,255,0.88); max-width: 700px; }
  .vtext a { color: #BAE3FF; }

  .contact-wrap { padding: 72px 0 12px; }
</style>
