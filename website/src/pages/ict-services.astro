---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
---
<Base
  title="ICT Services — Gross ICT | IT-Betreuung ohne Warteschlange"
  description="IT-Support, Security & Firewall, Netzwerk & WLAN, Server & Storage für KMU in der Zentralschweiz — persönlich und vor Ort."
  active="ict"
  ctaHref="#kontakt"
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="mono">(02) — ICT Services</p>
        <h1 class="reveal">IT, die einfach<br />läuft<span class="acid-txt">.</span></h1>
        <p class="lead">
          Sie erreichen direkt die Person, die Ihr Problem löst — keine
          Warteschlange, keine Ticketnummer-Odyssee. Vom Einzelarbeitsplatz
          bis zum ganzen Gebäude, per Fernwartung oder bei Ihnen im Betrieb.
        </p>
        <div class="cta-row">
          <a class="btn btn-acid" href="#kontakt">Support anfragen</a>
          <a class="btn btn-ghost" href="#vertrag">Support-Vertrag</a>
        </div>
      </div>
      <aside class="hero-facts" aria-label="Fakten">
        <div class="fact"><span class="k">Erreichbarkeit</span><span class="v">direkt, ohne Hotline</span></div>
        <div class="fact"><span class="k">Einsatz</span><span class="v">Fernwartung oder vor Ort</span></div>
        <div class="fact"><span class="k">Region</span><span class="v">Zentralschweiz</span></div>
        <div class="fact"><span class="k">Portal</span><span class="v">Tickets &amp; Rechnungen online</span></div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">ICT-Leistungen</h2>
        <p class="section-note">Alles aus einer Hand — persönlich, erreichbar, in Ihrer Nähe.</p>
      </div>
      <div class="xrows">
        <a class="xrow" href="#kontakt">
          <span class="idx">(01)</span>
          <div>
            <h3>Support &amp; Helpdesk</h3>
            <p class="desc">Per Telefon, Fernwartung oder bei Ihnen im Betrieb — Sie sprechen direkt mit der Person, die das Problem löst.</p>
          </div>
          <span class="tail">nach Aufwand <span class="arrow">↗</span></span>
        </a>
        <a class="xrow" href="#kontakt">
          <span class="idx">(02)</span>
          <div>
            <h3>Security &amp; Firewall</h3>
            <p class="desc">Firewall, Virenschutz, Updates und Sensibilisierung — damit ein Klick nicht zum Schaden wird.</p>
          </div>
          <span class="tail">auf Anfrage <span class="arrow">↗</span></span>
        </a>
        <a class="xrow" href="#kontakt">
          <span class="idx">(03)</span>
          <div>
            <h3>Netzwerk &amp; WLAN</h3>
            <p class="desc">Stabile Verkabelung, flächendeckendes WLAN und sauber getrennte Netze für Gäste und Betrieb — für ganze Gebäude geplant und umgesetzt.</p>
          </div>
          <span class="tail">auf Anfrage <span class="arrow">↗</span></span>
        </a>
        <a class="xrow" href="#kontakt">
          <span class="idx">(04)</span>
          <div>
            <h3>Server &amp; Storage</h3>
            <p class="desc">Lokal, Cloud oder hybrid — inklusive durchdachter Backup-Strategie, damit Ihre Daten auch im Ernstfall sicher sind.</p>
          </div>
          <span class="tail">auf Anfrage <span class="arrow">↗</span></span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container vertrag" id="vertrag">
      <div class="vertrag-text">
        <span class="mono" style="color: var(--ink)">(Support-Vertrag)</span>
        <h3>Sorglos-IT mit garantierten Reaktionszeiten</h3>
        <p>
          Monatlicher Fixpreis, definierte SLA, Wartung und Updates inklusive —
          und im <a href="https://portal.gross-ict.ch">Kundenportal</a> sehen Sie
          Tickets, Rechnungen und Verträge jederzeit online.
        </p>
      </div>
      <a class="btn btn-dark" href="#kontakt">Beratung anfragen ↗</a>
    </div>
  </section>

  <ContactForm
    heading="Support anfragen"
    intro="Brennt es gerade, rufen Sie direkt an — sonst beschreiben Sie kurz Ihr Anliegen, und Sie hören innert eines Arbeitstags von uns."
    messageLabel="Ihr Anliegen"
  />
</Base>

<style>
  .hero { padding: 92px 0 80px; border-bottom: 1px solid var(--line); }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: 72px;
    align-items: end;
  }
  .hero .mono { display: block; margin-bottom: 24px; }
  .hero h1 { font-size: clamp(44px, 7vw, 104px); }
  .acid-txt { color: var(--acid); }
  .lead { max-width: 560px; font-size: 17px; color: var(--mute); margin-top: 28px; }
  .cta-row { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .hero-facts { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
  .fact {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: baseline;
    padding: 13px 0;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
  }
  .fact .k {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mute);
  }
  .fact .v { text-align: right; }
  @media (max-width: 920px) {
    .hero { padding: 56px 0 48px; }
    .hero-grid { grid-template-columns: 1fr; gap: 40px; }
  }

  .vertrag {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 36px;
    flex-wrap: wrap;
    padding-top: 44px;
    padding-bottom: 52px;
    background: var(--acid);
    color: var(--ink);
  }
  .vertrag-text { display: flex; flex-direction: column; gap: 12px; max-width: 720px; }
  .vertrag h3 { font-size: clamp(24px, 3vw, 40px); color: var(--ink); }
  .vertrag p { font-size: 15px; }
  .vertrag a { color: var(--ink); }
  .vertrag a:hover { color: var(--ink); }
</style>
