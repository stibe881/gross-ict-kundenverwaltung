---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";

const referenzen = [
  {
    kunde: "GJONI WORK",
    titel: "Reinigungs- & Haus­wartungs­dienste",
    text: "Webauftritt für das Reinigungsunternehmen aus Emmenbrücke — klar strukturiert und auf Kundengewinnung ausgelegt.",
    url: "https://gjoni-work.ch",
    urlLabel: "gjoni-work.ch",
    tags: ["Webdesign", "Frontend", "MS365 Tenant"],
    shot: "/img/referenzen/gjoni.webp",
    env: "/img/umgebung/office.webp",
    alt: "Webseite von Gjoni Work auf einem Monitor in einem Büro",
  },
  {
    kunde: "STEINMANN MELKTECHNIK GMBH",
    titel: "Unternehmens­webseite",
    text: "Webpräsenz für Melktechnik und Stalleinrichtungen — mit Produkten, Projekten und Referenzen direkt vom Hof.",
    url: "https://steinmannhoftech.ch",
    urlLabel: "steinmannhoftech.ch",
    tags: ["Webdesign", "Frontend", "Dienstleistungen"],
    shot: "/img/referenzen/steinmann.webp",
    env: "/img/umgebung/barn.webp",
    alt: "Webseite der Steinmann Melktechnik GmbH auf einem Monitor im Kuhstall",
  },
  {
    kunde: "VIER KORKEN",
    titel: "Premium-Weinshop",
    text: "Onlineshop für erlesene Weine aus aller Welt — elegant, schnell und mit klarem Bestellprozess.",
    url: "https://vierkorken.ch",
    urlLabel: "vierkorken.ch",
    tags: ["Webdesign", "Webshop", "Backend"],
    shot: "/img/referenzen/vierkorken.webp",
    env: "/img/umgebung/cellar.webp",
    alt: "Webshop von Vier Korken auf einem Monitor im Weinkeller",
  },
  {
    kunde: "ACKERT GARTEN GMBH",
    titel: "Digitale Präsenz",
    text: "Webauftritt für den Gartenbaubetrieb — mit SEO-Basis und Inhalten, die das Team selbst pflegt.",
    url: "https://ackert.ch",
    urlLabel: "ackert.ch",
    tags: ["Webdesign", "Frontend", "Dienstleistungen"],
    shot: "/img/referenzen/ackert.webp",
    env: "/img/umgebung/garden.webp",
    alt: "Webseite der Ackert Garten GmbH auf einem Monitor im Garten",
  },
  {
    kunde: "DIE ROLLENDE PIZZERIA",
    titel: "Webseite & digitale Speisekarte",
    text: "Mobil-optimierte Website mit digitaler Speisekarte und klarer Bestellführung — fürs Geschäft auf vier Rädern.",
    url: "https://rollendepizzeria.ch",
    urlLabel: "rollendepizzeria.ch",
    tags: ["Webdesign", "Frontend", "MS365 Tenant"],
    shot: "/img/referenzen/pizzeria.webp",
    env: "/img/umgebung/pizza.webp",
    alt: "Webseite der Rollenden Pizzeria auf einem Monitor vor dem Holzofen",
  },
  {
    kunde: "FC ZELL",
    titel: "Vereins­webseite",
    text: "Webpräsenz für den Fussballclub Zell — mit Mannschaften, News, Spielplan und aktivem Vereinsleben.",
    url: "https://fczell.ch",
    urlLabel: "fczell.ch",
    tags: ["Webdesign", "Frontend"],
    shot: "/img/referenzen/fczell.webp",
    env: null,
    alt: "Webseite des FC Zell auf einem Monitor",
  },
];
---
<Base
  title="Referenzen — Gross ICT"
  description="Entdecken Sie unsere bisherigen Webprojekte und zufriedenen Kunden."
  active="referenzen"
>
  <div class="page-header" style="padding: 120px 24px 60px; max-width: 1240px; margin: 0 auto;">
    <p class="mono">Portfolio</p>
    <h1 class="anton anton-title" style="margin-top: 14px">Alle Referenzen</h1>
    <p style="color: var(--muted); font-size: 18px; margin-top: 16px; max-width: 600px;">
      Eine Übersicht unserer bisherigen Arbeiten. Webseiten, Webshops und Apps für KMU, Vereine und Selbstständige.
    </p>
  </div>

  <section class="section" id="referenzen-list" style="padding-top: 0;">
    <div class="container">
      {referenzen.map((r) => (
        <div class="ref-row" data-reveal>
          <div class="szene">
            <img class="bg blurred" src={r.env ?? r.shot} alt="" loading="lazy" />
            <div class="desk"></div>
            <div class="mon">
              <div class="frame"><img src={r.shot} alt={r.alt} loading="lazy" /></div>
              <div class="fuss"></div>
              <div class="sockel"></div>
            </div>
          </div>
          <div>
            <p class="mono ref-kunde" style="font-size: 12.5px; letter-spacing: 2.5px">{r.kunde}</p>
            <h3 class="ref-titel" set:html={r.titel} />
            <p class="ref-text">{r.text}</p>
            <a class="ref-link" href={r.url} target="_blank" rel="noopener noreferrer">{r.urlLabel} ansehen ↗</a>
            <div class="ref-tags">
              {r.tags.map((t) => <span class="tag">{t}</span>)}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Kontakt -->
  <section class="section" style="background: var(--panel-2);">
    <div class="container">
      <ContactForm />
    </div>
  </section>
</Base>
