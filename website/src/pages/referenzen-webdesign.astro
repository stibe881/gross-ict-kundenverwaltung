---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
import { optimiertesBild } from "../lib/bild";
import { ladeReferenzen } from "../lib/crm";

let referenzen = [];
try {
  const data = (await ladeReferenzen()).filter((r) => !r.bereich || r.bereich === 'web');
  referenzen = await Promise.all(data.map(async (r) => {
    const brancheTag = (r.tags || []).find(t => t.startsWith('Branche:'));
    const branche = brancheTag ? brancheTag.replace('Branche:', '').trim() : 'Sonstige';
    const visibleTags = (r.tags || []).filter(t => !t.startsWith('Branche:'));

    return {
      id: r.id,
      kunde: r.name,
      titel: r.titel,
      text: r.beschreibung,
      url: r.url,
      urlLabel: r.url_label || (r.url ? r.url.replace(/^https?:\/\//, '').replace(/\/$/, '') : ''),
      tags: visibleTags,
      branche: branche,
      shot: await optimiertesBild(r.bild_url),
      env: r.umgebung_bild_url || '/img/umgebung/office.webp',
      alt: `Webseite von ${r.name}`,
    };
  }));
} catch(e) {
  console.error("Fehler beim Laden der Referenzen:", e);
}
// Schutz vor einer leeren Referenzseite im automatischen Deploy (z.B. wenn die
// Lese-Regel aus Migration 20261025 fehlt): lieber abbrechen als leer veröffentlichen.
if (referenzen.length === 0 && process.env.CI) {
  throw new Error("Keine Referenzen aus dem CRM geladen — Migration 20261025 (website_references_public_read) ausgeführt?");
}

const branches = [...new Set(referenzen.map(r => r.branche))].sort();
---

<Base
  title="Webdesign-Referenzen — Gross ICT"
  description="Entdecken Sie unsere bisherigen Webprojekte und zufriedenen Kunden."
  active="referenzen"
>
  <div class="page-header" style="padding: 120px 24px 60px; max-width: 1240px; margin: 0 auto; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 40px;">
    <div style="flex: 1; min-width: 300px;">
      <p class="mono">Portfolio</p>
      <h1 class="anton anton-title" style="margin-top: 14px">Alle Referenzen</h1>
      <p style="color: var(--muted); font-size: 18px; margin-top: 16px; max-width: 600px;">
        Eine Übersicht unserer bisherigen Arbeiten. Webseiten, Webshops und Apps für KMU, Vereine und Selbstständige.
      </p>
    </div>

    <div class="branch-filters" style="margin-bottom: 0;">
      <button class="filter-btn active" data-branch="all">Alle Branchen</button>
      {branches.map(b => (
        <button class="filter-btn" data-branch={b}>{b}</button>
      ))}
    </div>
  </div>

  <section class="section" id="referenzen-list" style="padding-top: 0;">
    <div class="container">
      {referenzen.map((r) => (
        <div class="ref-row" data-reveal data-branch={r.branche}>
          {r.url ? (
            <a class="szene" href={r.url} target="_blank" rel="noopener noreferrer" aria-label={`${r.kunde}: Webseite öffnen`}>
              {r.shot && <img class="bg" src={r.shot} alt={r.alt} loading="lazy" />}
            </a>
          ) : (
            <div class="szene">
              {r.shot && <img class="bg" src={r.shot} alt={r.alt} loading="lazy" />}
            </div>
          )}
          <div>
            <p class="mono ref-kunde" style="font-size: 12.5px; letter-spacing: 2.5px">{r.kunde}</p>
            <h3 class="ref-titel" set:html={r.titel} />
            <p class="ref-text">{r.text}</p>
            {r.url && <a class="ref-link" href={r.url} target="_blank" rel="noopener noreferrer">{r.urlLabel} ansehen ↗</a>}
            <div class="ref-tags">
              {r.tags.map((t) => <span class="tag">{t}</span>)}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Kontakt -->
  <section class="section" style="background: var(--panel-2);">
    <div class="container">
      <ContactForm />
    </div>
  </section>
</Base>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const filters = document.querySelectorAll(".filter-btn");
    const rows = document.querySelectorAll(".ref-row");

    filters.forEach(btn => {
      btn.addEventListener("click", () => {
        // Update active class
        filters.forEach(f => f.classList.remove("active"));
        btn.classList.add("active");
        
        const selected = btn.getAttribute("data-branch");
        rows.forEach(row => {
          if (selected === "all" || row.getAttribute("data-branch") === selected) {
            row.style.display = "";
          } else {
            row.style.display = "none";
          }
        });
      });
    });
  });
</script>

<style>
  .branch-filters {
    display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 20px;
  }
  .filter-btn {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    padding: 9px 20px;
    font-size: 13px; font-weight: 700; letter-spacing: 0.4px;
    color: var(--muted);
    cursor: pointer;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transition: color 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease, transform 0.15s ease;
  }
  .filter-btn:hover { border-color: rgba(230, 178, 74, 0.55); color: var(--text); transform: translateY(-1px); }
  .filter-btn:active { transform: translateY(0); }
  .filter-btn.active {
    background: var(--gold);
    border-color: var(--gold);
    color: #221A0E;
    box-shadow: 0 6px 22px rgba(230, 178, 74, 0.35);
  }
  @media (max-width: 720px) {
    /* Eine wischbare Zeile statt mehrerer Umbruch-Reihen */
    .branch-filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding: 2px 2px 10px;
      margin-inline: -2px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .branch-filters::-webkit-scrollbar { display: none; }
    .filter-btn { flex: 0 0 auto; }
  }
</style>


