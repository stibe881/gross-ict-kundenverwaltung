---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
import fs from 'fs';
import path from 'path';

// ICT-Referenzen aus dem CRM (website_references, Bereich «ict»),
// sortiert nach Sortierung aufsteigend.
let referenzen = [];
try {
  const envPath = path.resolve('../.env');
  const envStr = fs.existsSync(envPath) ? fs.readFileSync(envPath, 'utf8') : '';
  const url = envStr.match(/EXPO_PUBLIC_SUPABASE_URL=(.*)/)?.[1]?.trim();
  const key = envStr.match(/SUPABASE_SERVICE_ROLE_KEY=(.*)/)?.[1]?.trim();
  if (url && key) {
    const res = await fetch(`${url}/rest/v1/website_references?select=*&active=eq.true&order=sort_order.asc`, {
      headers: { 'apikey': key, 'Authorization': `Bearer ${key}` }
    });
    if (res.ok) {
      const data = (await res.json()).filter((r) => r.bereich === 'ict');
      referenzen = data.map((r) => ({
        kunde: r.name,
        titel: r.titel,
        text: r.beschreibung,
        url: r.url,
        urlLabel: r.url_label || (r.url ? r.url.replace(/^https?:\/\//, '').replace(/\/$/, '') : ''),
        tags: (r.tags || []).filter((t) => !t.startsWith('Branche:')),
        shot: r.bild_url,
        alt: `Projekt für ${r.name}`,
      }));
    }
  }
} catch (e) {
  console.error('Fehler beim Laden der ICT-Referenzen:', e);
}
---
<Base
  title="ICT Referenzen — Gross ICT"
  description="Entdecken Sie unsere bisherigen ICT und Support Projekte."
  active="ict"
  theme="light"
>
  <div class="page-header" style="padding: 120px 24px 60px; max-width: 1240px; margin: 0 auto;">
    <p class="mono">Portfolio</p>
    <h1 class="anton anton-title" style="margin-top: 14px">ICT Referenzen</h1>
    <p style="color: var(--muted); font-size: 18px; margin-top: 16px; max-width: 600px;">
      Eine Übersicht unserer bisherigen IT-Infrastruktur- und Cloud-Projekte.
    </p>
  </div>

  <section class="section" id="referenzen-list" style="padding-top: 0;">
    <div class="container">
      {referenzen.length === 0 && (
        <p style="color: var(--muted); padding: 24px 0 48px;">Referenzen folgen in Kürze.</p>
      )}
      {referenzen.map((r) => (
        <div class="ref-row" data-reveal>
          {r.url && r.url !== "#" ? (
            <a class="szene" href={r.url} target="_blank" rel="noopener noreferrer" aria-label={`${r.kunde}: Webseite öffnen`}>
              <img class="bg" src={r.shot} alt={r.alt} loading="lazy" />
            </a>
          ) : (
            <div class="szene">
              <img class="bg" src={r.shot} alt={r.alt} loading="lazy" />
            </div>
          )}
          <div>
            <p class="mono ref-kunde" style="font-size: 12.5px; letter-spacing: 2.5px">{r.kunde}</p>
            <h3 class="ref-titel" set:html={r.titel} />
            <p class="ref-text">{r.text}</p>
            {r.url && r.url !== "#" && (
              <a class="ref-link" href={r.url} target="_blank" rel="noopener noreferrer">{r.urlLabel} ansehen ↗</a>
            )}
            <div class="ref-tags">
              {r.tags.map((t) => <span class="tag">{t}</span>)}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Kontakt -->
  <section class="section" style="background: var(--panel-2);">
    <div class="container">
      <ContactForm />
    </div>
  </section>
</Base>
