---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";

const referenzen = [
  {
    kunde: "BEISPIEL AG",
    titel: "Server-Migration & Cloud",
    text: "Komplette Migration der lokalen Server-Infrastruktur in eine hochverfügbare Cloud-Lösung. Inklusive Modern Workplace Setup für 50 Mitarbeiter.",
    url: "#",
    urlLabel: "Details",
    tags: ["Microsoft 365", "Cloud", "Migration", "Netzwerk"],
    shot: "/img/umgebung/ict.webp",
    env: "/img/umgebung/office.webp",
    alt: "ICT Infrastruktur in einem modernen Büro"
  }
];
---
<Base
  title="ICT Referenzen — Gross ICT"
  description="Entdecken Sie unsere bisherigen ICT und Support Projekte."
  active="ict"
  theme="light"
>
  <div class="page-header" style="padding: 120px 24px 60px; max-width: 1240px; margin: 0 auto;">
    <p class="mono">Portfolio</p>
    <h1 class="anton anton-title" style="margin-top: 14px">ICT Referenzen</h1>
    <p style="color: var(--muted); font-size: 18px; margin-top: 16px; max-width: 600px;">
      Eine Übersicht unserer bisherigen IT-Infrastruktur- und Cloud-Projekte.
    </p>
  </div>

  <section class="section" id="referenzen-list" style="padding-top: 0;">
    <div class="container">
      {referenzen.map((r) => (
        <div class="ref-row" data-reveal>
          {r.url && r.url !== "#" ? (
            <a class="szene" href={r.url} target="_blank" rel="noopener noreferrer" aria-label={`${r.kunde}: Webseite öffnen`}>
              <img class="bg" src={r.shot} alt={r.alt} loading="lazy" />
            </a>
          ) : (
            <div class="szene">
              <img class="bg" src={r.shot} alt={r.alt} loading="lazy" />
            </div>
          )}
          <div>
            <p class="mono ref-kunde" style="font-size: 12.5px; letter-spacing: 2.5px">{r.kunde}</p>
            <h3 class="ref-titel" set:html={r.titel} />
            <p class="ref-text">{r.text}</p>
            <a class="ref-link" href={r.url} target="_blank" rel="noopener noreferrer">{r.urlLabel} ansehen ↗</a>
            <div class="ref-tags">
              {r.tags.map((t) => <span class="tag">{t}</span>)}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Kontakt -->
  <section class="section" style="background: var(--panel-2);">
    <div class="container">
      <ContactForm />
    </div>
  </section>
</Base>
