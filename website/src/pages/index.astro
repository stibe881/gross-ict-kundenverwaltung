---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
---
<Base
  title="Gross ICT — Webdesign & ICT Services, Zentralschweiz"
  description="Gross ICT aus Zell LU: Webseiten zum Festpreis ab CHF 1'500 und IT-Betreuung ohne Warteschlange für KMU in der Zentralschweiz."
  ctaHref="#kontakt"
>
  <section class="hero">
    <div class="container">
      <p class="mono">(Webagentur &amp; ICT — Zell, Luzern)</p>
      <h1 class="mega reveal">
        <span class="l">Webseiten,</span>
        <span class="l indent">Apps &amp; IT<span class="acid-txt">*</span></span>
        <span class="l">für die Zentralschweiz</span>
      </h1>
      <div class="hero-foot">
        <p class="hero-note"><span class="acid-txt">*</span> Festpreis statt Überraschung: Webauftritte ab CHF 1'500, IT-Betreuung, bei der Sie direkt die Person erreichen, die das Problem löst.</p>
        <div class="hero-cta">
          <a class="btn btn-acid" href="/rechner">Preis berechnen</a>
          <a class="btn btn-ghost" href="#kontakt">Projekt anfragen</a>
        </div>
      </div>
    </div>
  </section>

  <section class="panels" aria-label="Bereiche">
    <div class="container panel-grid">
      <a class="panel" href="/webdesign">
        <span class="mono idx">(01)</span>
        <h2>Webdesign <span class="arrow">↗</span></h2>
        <p>Webseiten, Web-Apps und Mobile Apps — selbst pflegbar, auffindbar, sauber nach revDSG und WCAG gebaut. Ab CHF 1'500.</p>
      </a>
      <a class="panel" href="/ict-services">
        <span class="mono idx">(02)</span>
        <h2>ICT Services <span class="arrow">↗</span></h2>
        <p>Support, Security, Netzwerk und Server — ohne Warteschlange, per Fernwartung oder vor Ort.</p>
      </a>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="track">
      <div class="seq">
        <span>Webseiten</span><span>Web-Apps</span><span>Mobile Apps</span><span>IT-Support</span><span>Security</span><span>Netzwerk &amp; WLAN</span><span>Server &amp; Backup</span><span>Hosting Schweiz</span>
      </div>
      <div class="seq">
        <span>Webseiten</span><span>Web-Apps</span><span>Mobile Apps</span><span>IT-Support</span><span>Security</span><span>Netzwerk &amp; WLAN</span><span>Server &amp; Backup</span><span>Hosting Schweiz</span>
      </div>
    </div>
  </div>

  <section class="section">
    <div class="container facts">
      <div class="fact">
        <span class="mono">(Preis)</span>
        <p class="big">ab CHF 1'500</p>
        <p class="small">Webauftritt zum Festpreis — der Preis steht, bevor wir anfangen.</p>
      </div>
      <div class="fact">
        <span class="mono">(Antwort)</span>
        <p class="big">1 Arbeitstag</p>
        <p class="small">So lange warten Sie höchstens auf eine persönliche Antwort.</p>
      </div>
      <div class="fact">
        <span class="mono">(Recht)</span>
        <p class="big">revDSG + WCAG</p>
        <p class="small">Datenschutz und Barrierefreiheit sind eingebaut, kein Aufpreis-Thema.</p>
      </div>
      <div class="fact">
        <span class="mono">(Hosting)</span>
        <p class="big">Schweiz</p>
        <p class="small">Ihre Daten bleiben hier — Server und Support im selben Land.</p>
      </div>
    </div>
  </section>

  <ContactForm />
</Base>

<style>
  .hero { padding: 104px 0 88px; border-bottom: 1px solid var(--line); }
  .hero .mono { display: block; margin-bottom: 26px; }
  .mega { display: flex; flex-direction: column; font-size: clamp(44px, 9vw, 128px); }
  .mega .l { display: block; }
  .mega .indent { padding-left: clamp(40px, 12vw, 220px); }
  .acid-txt { color: var(--acid); }
  .hero-foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    flex-wrap: wrap;
    margin-top: 48px;
  }
  .hero-note { max-width: 460px; color: var(--mute); font-size: 15.5px; }
  .hero-cta { display: flex; gap: 12px; flex-wrap: wrap; }
  @media (max-width: 640px) {
    .hero { padding: 64px 0 56px; }
    .hero-foot { margin-top: 32px; }
  }

  .panels { padding: 0; }
  .panel-grid {
    display: grid;
    grid-template-columns: 58fr 42fr;
    gap: 0;
    padding: 0;
    max-width: none;
  }
  .panel {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 56px 48px 64px;
    border-bottom: 1px solid var(--line);
    color: var(--fg);
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .panel + .panel { border-left: 1px solid var(--line); }
  .panel h2 { font-size: clamp(32px, 4.6vw, 64px); }
  .panel .arrow { color: var(--acid); }
  .panel p { color: var(--mute); font-size: 15px; max-width: 480px; }
  .panel:hover { background: var(--acid); color: var(--ink); }
  .panel:hover .idx, .panel:hover p { color: var(--ink); }
  .panel:hover h2, .panel:hover .arrow { color: var(--ink); }
  @media (max-width: 860px) {
    .panel-grid { grid-template-columns: 1fr; }
    .panel { padding: 36px 28px 44px; }
    .panel + .panel { border-left: none; }
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .fact {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 30px 24px 36px 0;
    border-bottom: 1px solid var(--line);
  }
  .fact + .fact { padding-left: 24px; border-left: 1px solid var(--line); }
  .fact .big {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: clamp(20px, 2.4vw, 30px);
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }
  .fact .small { color: var(--mute); font-size: 13.5px; }
  @media (max-width: 860px) {
    .facts { grid-template-columns: 1fr 1fr; }
    .fact:nth-child(3) { padding-left: 0; border-left: none; }
  }
  @media (max-width: 520px) {
    .facts { grid-template-columns: 1fr; }
    .fact + .fact { padding-left: 0; border-left: none; }
  }
</style>
