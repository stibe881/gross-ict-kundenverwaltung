---
import Base from "../layouts/Base.astro";
---
<Base
  title="Gross ICT — Webdesign & ICT Services, Zentralschweiz"
  description="Gross ICT aus Zell LU: Webseiten zum Festpreis ab CHF 1'500 und IT-Betreuung ohne Warteschlange für KMU in der Zentralschweiz."
  noChrome
>
  <div class="home">
    <header class="topbar">
      <a class="brand" href="/">Gross<span class="mark">&nbsp;·&nbsp;</span>ICT</a>
      <p class="topbar-note">Zell LU · Zentralschweiz</p>
      <a class="btn-login" href="https://portal.gross-ict.ch">Kunden-Login</a>
    </header>

    <div class="fields">
      <!-- Webdesign: 58% -->
      <a class="field field-web" href="/webdesign">
        <p class="label field-label">Webseiten · Web-Apps · Mobile Apps</p>
        <div class="field-foot">
          <h1 class="reveal">Webdesign<span class="dot">.</span></h1>
          <p class="field-text">
            Ein Auftritt zum Festpreis ab CHF 1'500 — selbst pflegbar,
            auffindbar, sauber nach revDSG und WCAG gebaut.
          </p>
          <span class="go">Entdecken <span aria-hidden="true">→</span></span>
        </div>
        <span class="idx" aria-hidden="true">01</span>
      </a>

      <!-- ICT Services: 42% -->
      <a class="field field-ict" href="/ict-services">
        <p class="label field-label">Support · Security · Netzwerk · Server</p>
        <div class="field-foot">
          <h1 class="reveal">ICT Services<span class="dot">.</span></h1>
          <p class="field-text">
            Sie rufen an, wir nehmen ab: IT-Betreuung ohne Warteschlange,
            vor Ort in der Zentralschweiz.
          </p>
          <span class="go">Entdecken <span aria-hidden="true">→</span></span>
        </div>
        <span class="idx" aria-hidden="true">02</span>
      </a>
    </div>

    <footer class="baseline">
      <p>Neuhushof 3, 6144 Zell</p>
      <p><a href="tel:+41415623416">+41 41 562 34 16</a> · <a href="mailto:info@gross-ict.ch">info@gross-ict.ch</a></p>
      <p><a href="/rechner">Preisrechner</a> · <a href="/impressum">Impressum</a> · <a href="/datenschutz">Datenschutz</a></p>
    </footer>
  </div>
</Base>

<style>
  .home {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
    background: var(--ink);
  }
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 0 28px;
    min-height: 64px;
    border-bottom: 1px solid var(--line);
  }
  .topbar-note {
    font-size: 11.5px;
    letter-spacing: 0.17em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (max-width: 560px) { .topbar-note { display: none; } }

  .fields { display: flex; flex: 1; min-height: 0; }
  .field {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 36px 40px 44px;
    color: var(--paper);
    text-decoration: none;
    overflow: hidden;
  }
  .field-web { flex: 58; background: var(--clay); }
  .field-ict { flex: 42; background: var(--pine); border-left: 1px solid var(--ink); }

  .field-label { color: rgba(239, 234, 227, 0.75); }
  .field-foot { display: flex; flex-direction: column; gap: 16px; max-width: 520px; }
  .field h1 {
    font-size: clamp(44px, 6.5vw, 96px);
    font-weight: 600;
    color: var(--paper);
    line-height: 1.02;
  }
  .field .dot { color: var(--ink); }
  .field-text { font-size: 16px; line-height: 1.6; color: rgba(239, 234, 227, 0.88); max-width: 420px; }
  .go {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 6px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--paper);
    border-bottom: 1px solid var(--paper);
    padding-bottom: 6px;
    width: fit-content;
  }
  .field:hover .go { color: var(--ink); border-color: var(--ink); }
  .field:hover .go span[aria-hidden] { transform: translateX(4px); }
  .go span[aria-hidden] { transition: transform 0.2s ease; }

  .idx {
    position: absolute;
    top: 28px;
    right: 36px;
    font-family: "Fraunces", Georgia, serif;
    font-size: 15px;
    color: rgba(239, 234, 227, 0.55);
  }

  .baseline {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding: 18px 28px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: var(--muted);
  }
  .baseline a { color: var(--muted); }
  .baseline a:hover { color: var(--text); }

  @media (max-width: 860px) {
    .fields { flex-direction: column; }
    .field { padding: 28px 24px 36px; }
    .field-web { flex: none; min-height: 52vh; }
    .field-ict { flex: none; min-height: 42vh; border-left: none; border-top: 1px solid var(--ink); }
    .field h1 { font-size: clamp(40px, 11vw, 64px); }
    .baseline { flex-direction: column; gap: 4px; }
  }
</style>
