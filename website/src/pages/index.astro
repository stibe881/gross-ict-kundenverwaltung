---
import Base from "../layouts/Base.astro";
---
<Base
  title="Gross ICT — Web- & Appdesign und ICT Services, Zentralschweiz"
  description="Gross ICT aus Zell LU: Web- und Appdesign zum Festpreis ab CHF 1'500 und ICT Services ohne Warteschlange für KMU in der Zentralschweiz."
  noChrome
>
  <div class="split">
    <!-- Linke Welt: Web- und Appdesign -->
    <a href="/webdesign" class="half half-web" aria-label="Web- und Appdesign" style="text-decoration: none;">
      <img class="berg" src="/img/umgebung/sunset.webp" alt="" aria-hidden="true" />
      <div class="glow g1" aria-hidden="true"></div>
      <div class="dots" aria-hidden="true"></div>

      <div class="deko" aria-hidden="true">
        <div class="ui-card c1">
          <div class="dots-row"><span></span><span></span><span></span></div>
          <div class="bar w70 strong"></div>
          <div class="bar w90"></div>
          <div class="bar w60"></div>
          <div class="chip-btn"></div>
        </div>
        <div class="ui-card c2">
          <div class="media"></div>
          <div class="bar w80"></div>
          <div class="bar w55"></div>
        </div>
        <div class="ui-card c3 phone">
          <div class="media tall"></div>
          <div class="bar w85 strong"></div>
          <div class="bar w60"></div>
          <div class="home-dash"></div>
        </div>
        <span class="deko-chip d1">&lt;UI/UX DESIGN&gt;</span>
        <span class="deko-chip d2">APP DEV</span>
        <span class="deko-chip d3">BUILD</span>
      </div>

      <div class="content">
        <h1>WEB- UND<br />APPDESIGN</h1>
        <p class="hover-text">Webseiten, Web-Apps und Mobile Apps — zum Festpreis, rechtssicher nach revDSG, barrierefrei nach WCAG.</p>
      </div>
    </a>

    <!-- Rechte Welt: ICT Services -->
    <a href="/ict-services" class="half half-ict" aria-label="ICT Services" style="text-decoration: none;">
      <img class="berg" src="/img/umgebung/ict-gipfel.webp" alt="" aria-hidden="true" />
      <div class="glow g2" aria-hidden="true"></div>
      <div class="gridlines" aria-hidden="true"></div>

      <svg class="circuit" width="640" height="860" viewBox="0 0 640 860" fill="none" aria-hidden="true">
        <path d="M20 120 H220 L280 180 V420" stroke="#38BDF8" stroke-opacity="0.5" stroke-width="1.5"/>
        <path d="M40 760 H260 L340 680 H620" stroke="#38BDF8" stroke-opacity="0.4" stroke-width="1.5"/>
        <path d="M520 80 V260 L440 340 V520" stroke="#7DD3FC" stroke-opacity="0.45" stroke-width="1.5"/>
        <path d="M600 500 H480 L420 560 V760" stroke="#38BDF8" stroke-opacity="0.35" stroke-width="1.5"/>
        <circle cx="280" cy="420" r="5" fill="#7DD3FC"/>
        <circle cx="220" cy="120" r="4" fill="#38BDF8"/>
        <circle cx="340" cy="680" r="5" fill="#7DD3FC"/>
        <circle cx="440" cy="340" r="4" fill="#38BDF8"/>
        <circle cx="420" cy="760" r="4" fill="#38BDF8"/>
      </svg>
      <span class="tech-label t1" aria-hidden="true">CYBERSECURITY</span>
      <span class="tech-label t2" aria-hidden="true">DATA ENCRYPTION</span>
      <svg class="tech-icon i1" width="34" height="40" viewBox="0 0 24 28" fill="none" stroke="#7DD3FC" stroke-width="1.6" aria-hidden="true"><path d="M12 2 3 5.5v7c0 6 3.9 10.8 9 12.5 5.1-1.7 9-6.5 9-12.5v-7L12 2Z"/><path d="M8.5 13.5l2.5 2.5 4.5-5"/></svg>
      <svg class="tech-icon i2" width="30" height="36" viewBox="0 0 24 28" fill="none" stroke="#38BDF8" stroke-width="1.6" aria-hidden="true"><rect x="4" y="11" width="16" height="12" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>

      <div class="content">
        <h1>ICT SERVICES</h1>
        <p class="hover-text">Zuverlässiger IT-Support, Netzwerk, Security und Cloud-Lösungen für KMU.</p>
      </div>
    </a>

    <!-- Freigestelltes Logo oben Mitte -->
    <a class="home-logo" href="/webdesign" aria-label="Gross ICT">
      <img src="/assets/logo.webp" alt="Gross ICT" />
    </a>

    <!-- Kontaktzeile unten -->
    <p class="contact-line">
      Neuhushof 3, 6144 Zell · <a href="tel:+41415623416">+41 41 562 34 16</a> · <a href="mailto:info@gross-ict.ch">info@gross-ict.ch</a>
    </p>
  </div>
</Base>

<style>
  .split {
    position: relative;
    display: flex;
    min-height: 100vh;
    min-height: 100dvh;
    background: var(--bg);
  }
  .half {
    position: relative;
    overflow: hidden;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 150px 36px 100px;
    transition: flex 0.35s ease;
  }
  @media (min-width: 901px) {
    .half:hover, .half:focus-within { flex: 1.15; }
  }
  .half-web { background: var(--grad-web); }
  .half-ict { background: var(--grad-ict); border-left: 1px solid rgba(255,255,255,0.25); }

  /* Berg-Hintergrund je Bereich: durch den Farbverlauf eingefärbt,
     beim Darüberfahren langsamer Zoom und klarer sichtbar */
  .berg {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0.4;
    transform: scale(1.06);
    transition: transform 5s ease, opacity 0.7s ease;
    pointer-events: none;
  }
  .half-web .berg { object-position: 62% center; }
  .half-ict .berg { object-position: 55% 30%; }
  .half:hover .berg,
  .half:focus-within .berg { opacity: 0.58; transform: scale(1.14); }
  @media (prefers-reduced-motion: reduce) {
    .berg { transition: opacity 0.7s ease; transform: none; }
    .half:hover .berg, .half:focus-within .berg { transform: none; }
  }

  .glow { position: absolute; border-radius: 50%; pointer-events: none; }
  .g1 { width: 540px; height: 540px; background: rgba(255,255,255,0.15); filter: blur(90px); top: -140px; left: -120px; }
  .g2 { width: 560px; height: 560px; background: rgba(56,189,248,0.3); filter: blur(100px); top: -160px; right: -140px; }
  .dots {
    position: absolute; inset: 0; pointer-events: none;
    background-image: radial-gradient(rgba(255,255,255,0.16) 1px, transparent 1px);
    background-size: 26px 26px; opacity: 0.35;
  }
  .gridlines {
    position: absolute; inset: 0; pointer-events: none;
    background-image: linear-gradient(rgba(125,211,252,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(125,211,252,0.1) 1px, transparent 1px);
    background-size: 44px 44px; opacity: 0.6;
  }

  /* Schwebende UI-Motive links */
  .deko { position: absolute; inset: 0; pointer-events: none; }
  .ui-card {
    position: absolute;
    border: 1px solid rgba(255,255,255,0.4);
    border-radius: 14px;
    background: rgba(255,255,255,0.09);
    padding: 12px;
  }
  .ui-card .dots-row { display: flex; gap: 5px; margin-bottom: 12px; }
  .ui-card .dots-row span { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,0.55); }
  .ui-card .dots-row span:first-child { background: rgba(255,255,255,0.75); }
  .ui-card .bar { height: 8px; border-radius: 4px; background: rgba(255,255,255,0.3); margin-top: 7px; }
  .ui-card .bar.strong { height: 10px; background: rgba(255,255,255,0.55); }
  .ui-card .w55 { width: 55%; } .ui-card .w60 { width: 60%; } .ui-card .w70 { width: 70%; }
  .ui-card .w80 { width: 80%; } .ui-card .w85 { width: 85%; } .ui-card .w90 { width: 90%; }
  .ui-card .chip-btn { width: 76px; height: 20px; border-radius: 10px; background: rgba(255,255,255,0.85); margin-top: 12px; }
  .ui-card .media { height: 48px; border-radius: 8px; background: rgba(255,255,255,0.25); }
  .ui-card .media.tall { height: 90px; border-radius: 12px; }
  .ui-card .home-dash { width: 46px; height: 5px; border-radius: 3px; background: rgba(255,255,255,0.5); margin: 14px auto 0; }
  .c1 { top: 120px; left: 70px; width: 200px; transform: rotate(-6deg); }
  .c2 { bottom: 150px; left: 110px; width: 170px; transform: rotate(5deg); }
  .c3 { top: 150px; right: 90px; width: 150px; border-radius: 20px; transform: rotate(7deg); }
  .deko-chip {
    position: absolute;
    font-family: "Sora", monospace;
    font-size: 12px;
    letter-spacing: 1px;
    color: rgba(255,255,255,0.75);
    border: 1px solid rgba(255,255,255,0.4);
    border-radius: 999px;
    padding: 5px 13px;
  }
  .d1 { top: 88px; right: 250px; transform: rotate(-4deg); }
  .d2 { bottom: 110px; right: 110px; transform: rotate(4deg); }
  .d3 { top: 330px; left: 42px; transform: rotate(-8deg); }
  @media (max-width: 1100px) { .c3, .d1 { display: none; } }

  /* Leiterbahnen rechts */
  .circuit { position: absolute; top: 20px; left: 20px; opacity: 0.55; pointer-events: none; }
  .tech-label {
    position: absolute;
    font-family: "Sora", monospace;
    font-size: 11px;
    letter-spacing: 2px;
    color: rgba(125,211,252,0.8);
    pointer-events: none;
  }
  .t1 { top: 200px; right: 60px; transform: rotate(3deg); }
  .t2 { bottom: 180px; left: 70px; transform: rotate(-3deg); }
  .tech-icon { position: absolute; opacity: 0.8; pointer-events: none; }
  .i1 { top: 300px; left: 80px; }
  .i2 { bottom: 260px; right: 120px; }

  .content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    max-width: 460px;
    text-align: center;
  }
  .content h1 {
    font-size: clamp(30px, 3.6vw, 48px);
    font-weight: 800;
    letter-spacing: 3px;
    line-height: 1.18;
    color: #fff;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.45);
  }
  .content p.hover-text {
    font-size: 17px;
    color: rgba(255,255,255,0.93);
    margin: 0;
    padding: 0;
    opacity: 0;
    max-height: 0;
    transform: translateY(10px);
    transition: all 0.4s ease;
    overflow: hidden;
  }
  .half:hover .content p.hover-text,
  .half:focus-within .content p.hover-text {
    opacity: 1;
    max-height: 100px;
    transform: translateY(0);
    padding-top: 16px;
  }
  
  @media (max-width: 900px) {
    /* Auf dem Smartphone direkt anzeigen, da es keinen echten Hover gibt */
    .content p.hover-text {
      opacity: 1;
      max-height: 200px;
      transform: translateY(0);
      padding-top: 12px;
    }
  }

  .home-logo { position: absolute; top: 34px; left: 50%; transform: translateX(-50%); z-index: 2; }
  .home-logo img {
    display: block;
    height: 76px;
    width: auto;
    filter: brightness(1.45) drop-shadow(0 2px 12px rgba(0,0,0,0.55));
  }

  .contact-line {
    position: absolute;
    bottom: 24px;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 17px;
    font-weight: 600;
    color: rgba(255,255,255,0.92);
    z-index: 2;
  }
  .contact-line a { color: rgba(255,255,255,0.95); }

  @media (max-width: 900px) {
    .split { flex-direction: column; }
    .half { padding: 130px 28px 80px; }
    .half-ict { border-left: none; border-top: 1px solid rgba(255,255,255,0.25); padding-top: 90px; }
    .home-logo img { height: 56px; }
    .contact-line { position: static; padding: 18px 16px 26px; background: var(--bg); font-size: 14.5px; }
  }
</style>
