---
import Base from "../layouts/Base.astro";
---
<Base
  title="Gross ICT — Web- & Appdesign und ICT Services, Zentralschweiz"
  description="Gross ICT aus Zell LU: Web- und Appdesign zum Festpreis ab CHF 1'500 und ICT Services ohne Warteschlange für KMU in der Zentralschweiz."
  noChrome
>
  <div class="split">
    <!-- Linke Welt: Web- und Appdesign -->
    <a href="/webdesign" class="half half-web" aria-label="Web- und Appdesign" style="text-decoration: none;">
      <img class="berg" src="/img/umgebung/sunset.webp" alt="" aria-hidden="true" />
      <div class="nebel" aria-hidden="true"></div>

      <div class="content">
        <h1>WEB- UND<br />APPDESIGN</h1>
        <p class="hover-text">Webseiten, Web-Apps und Mobile Apps — zum Festpreis, rechtssicher nach revDSG, barrierefrei nach WCAG.</p>
      </div>
    </a>

    <!-- Rechte Welt: ICT Services -->
    <a href="/ict-services" class="half half-ict" aria-label="ICT Services" style="text-decoration: none;">
      <img class="berg" src="/img/umgebung/ict-gipfel.webp" alt="" aria-hidden="true" />
      <div class="nebel" aria-hidden="true"></div>

      <div class="content">
        <h1>ICT SERVICES</h1>
        <p class="hover-text">Zuverlässiger IT-Support, Netzwerk, Security und Cloud-Lösungen für KMU.</p>
      </div>
    </a>

    <!-- Freigestelltes Logo oben Mitte -->
    <a class="home-logo" href="/webdesign" aria-label="Gross ICT">
      <img src="/assets/logo.webp" alt="Gross ICT" />
    </a>

    <!-- Kontaktzeile unten -->
    <p class="contact-line">
      Neuhushof 3, 6144 Zell · <a href="tel:+41415623416">+41 41 562 34 16</a> · <a href="mailto:info@gross-ict.ch">info@gross-ict.ch</a>
    </p>
  </div>
</Base>

<style>
  .split {
    position: relative;
    display: flex;
    min-height: 100vh;
    min-height: 100dvh;
    background: var(--bg);
  }
  .half {
    position: relative;
    overflow: hidden;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 150px 36px 100px;
    transition: flex 0.35s ease;
  }
  @media (min-width: 901px) {
    .half:hover, .half:focus-within { flex: 1.15; }
  }
  .half-web { background: #0B0E1A; }
  .half-ict { background: #0B0E1A; border-left: 1px solid rgba(255,255,255,0.3); }

  /* Berg-Hintergrund je Bereich: durch den Farbverlauf eingefärbt,
     beim Darüberfahren langsamer Zoom und klarer sichtbar */
  .berg {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    transform: scale(1.06);
    filter: saturate(0.6) brightness(1.03) blur(2px);
    transition: transform 5s ease, filter 1.1s ease;
    pointer-events: none;
  }
  .half-web .berg { object-position: 62% center; }
  .half-ict .berg { object-position: 55% 30%; }
  .half:hover .berg,
  .half:focus-within .berg {
    transform: scale(1.14);
    filter: saturate(1) brightness(1) blur(0);
  }
  /* Nebel: mehrere weichgezeichnete Schwaden, die langsam driften —
     löst sich beim Darüberfahren (bzw. Antippen) auf */
  .nebel {
    position: absolute; inset: 0;
    overflow: hidden;
    background: linear-gradient(180deg, rgba(226,232,241,0.28) 0%, rgba(226,232,241,0.16) 55%, rgba(232,237,245,0.26) 100%);
    transition: opacity 1.2s ease;
    pointer-events: none;
  }
  .nebel::before,
  .nebel::after {
    content: "";
    position: absolute; top: -25%; bottom: -25%; left: -55%; width: 210%;
    background-image:
      radial-gradient(42% 56% at 18% 38%, rgba(238,242,248,0.85), transparent 70%),
      radial-gradient(34% 46% at 52% 68%, rgba(228,234,243,0.72), transparent 70%),
      radial-gradient(46% 58% at 84% 28%, rgba(241,244,250,0.78), transparent 70%);
    filter: blur(28px);
    animation: nebel-drift 48s ease-in-out infinite alternate;
  }
  .nebel::after {
    background-image:
      radial-gradient(38% 50% at 30% 72%, rgba(233,238,246,0.7), transparent 70%),
      radial-gradient(32% 42% at 68% 42%, rgba(243,246,251,0.72), transparent 70%),
      radial-gradient(28% 38% at 92% 78%, rgba(229,235,244,0.62), transparent 70%);
    filter: blur(34px);
    animation-duration: 70s;
    animation-direction: alternate-reverse;
  }
  @keyframes nebel-drift {
    from { transform: translateX(-5%) translateY(-1.5%); }
    to   { transform: translateX(5%) translateY(1.5%); }
  }
  .half:hover .nebel,
  .half:focus-within .nebel,
  .half.klar .nebel { opacity: 0.04; }
  .half.klar .berg {
    transform: scale(1.14);
    filter: saturate(1) brightness(1) blur(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .berg { transition: filter 1.1s ease; transform: none; }
    .half:hover .berg, .half:focus-within .berg, .half.klar .berg { transform: none; }
    .nebel::before, .nebel::after { animation: none; }
  }


  .content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    max-width: 460px;
    text-align: center;
  }
  .content h1 {
    font-size: clamp(30px, 3.6vw, 48px);
    font-weight: 800;
    letter-spacing: 3px;
    line-height: 1.18;
    color: #fff;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.45);
  }
  .content p.hover-text {
    font-size: 17px;
    color: rgba(255,255,255,0.93);
    margin: 0;
    padding: 0;
    opacity: 0;
    max-height: 0;
    transform: translateY(10px);
    transition: all 0.4s ease;
    overflow: hidden;
  }
  .half:hover .content p.hover-text,
  .half:focus-within .content p.hover-text {
    opacity: 1;
    max-height: 100px;
    transform: translateY(0);
    padding-top: 16px;
  }
  
  @media (max-width: 900px) {
    /* Auf dem Smartphone direkt anzeigen, da es keinen echten Hover gibt */
    .content p.hover-text {
      opacity: 1;
      max-height: 200px;
      transform: translateY(0);
      padding-top: 12px;
    }
  }

  .home-logo { position: absolute; top: 34px; left: 50%; transform: translateX(-50%); z-index: 2; }
  .home-logo img {
    display: block;
    height: 76px;
    width: auto;
    filter: brightness(1.45) drop-shadow(0 2px 12px rgba(0,0,0,0.55));
  }

  .contact-line {
    position: absolute;
    bottom: 24px;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 17px;
    font-weight: 600;
    color: rgba(255,255,255,0.92);
    z-index: 2;
  }
  .contact-line a { color: rgba(255,255,255,0.95); }

  @media (max-width: 900px) {
    .split { flex-direction: column; }
    .half { padding: 130px 28px 80px; }
    .half-ict { border-left: none; border-top: 1px solid rgba(255,255,255,0.25); padding-top: 90px; }
    .home-logo img { height: 56px; }
    .contact-line { position: static; padding: 18px 16px 26px; background: var(--bg); font-size: 14.5px; }
  }
</style>

<script>
  // Auf Geräten ohne Maus: erster Tipp lichtet den Nebel, danach öffnet
  // sich die Seite automatisch. Am Desktop übernimmt das der Hover.
  const halves = document.querySelectorAll<HTMLAnchorElement>(".half");
  const hatHover = window.matchMedia("(hover: hover)").matches;
  halves.forEach((half) => {
    half.addEventListener("click", (e) => {
      if (hatHover || half.classList.contains("klar")) return;
      e.preventDefault();
      halves.forEach((h) => h.classList.remove("klar"));
      half.classList.add("klar");
      setTimeout(() => { window.location.href = half.href; }, 1000);
    });
  });
</script>
