---
import Base from "../layouts/Base.astro";
---
<Base
  title="Gross ICT — Webdesign & ICT Services, Zentralschweiz"
  description="Gross ICT aus Zell LU: Moderne Webseiten ab CHF 1'500 und IT-Support ohne Warteschlange für KMU in der Zentralschweiz."
  noChrome
>
  <div class="split">
    <!-- Webdesign -->
    <section class="half half-web" aria-label="Webdesign">
      <div class="glow g1"></div>
      <div class="content">
        <div class="pills">
          <span class="pill">WEBSEITEN</span>
          <span class="pill">WEB-APPS</span>
          <span class="pill">MOBILE APPS</span>
        </div>
        <h1>WEBDESIGN</h1>
        <p>Moderne Webseiten und Apps — rechtssicher nach revDSG, barrierefrei nach WCAG, ab CHF 1'500.</p>
        <a class="discover" href="/webdesign">ENTDECKEN</a>
      </div>
    </section>

    <!-- ICT Services -->
    <section class="half half-ict" aria-label="ICT Services">
      <div class="glow g2"></div>
      <div class="content">
        <div class="pills">
          <span class="pill">SUPPORT</span>
          <span class="pill">SECURITY</span>
          <span class="pill">NETZWERK</span>
          <span class="pill">SERVER</span>
        </div>
        <h1>ICT SERVICES</h1>
        <p>IT-Support ohne Warteschlange — Security, Netzwerk und Server für KMU in der Zentralschweiz.</p>
        <a class="discover" href="/ict-services">ENTDECKEN</a>
      </div>
    </section>

    <!-- Logo -->
    <div class="logo-chip">
      <span class="mark">( )</span>
      <span class="name">GROSS <span class="mark">·</span> ICT</span>
    </div>

    <!-- Kontaktzeile -->
    <p class="contact-line">
      Neuhushof 3, 6144 Zell · <a href="tel:+41415623416">+41 41 562 34 16</a> · <a href="mailto:info@gross-ict.ch">info@gross-ict.ch</a>
    </p>
  </div>
</Base>

<style>
  .split {
    position: relative;
    display: flex;
    min-height: 100vh;
    min-height: 100dvh;
    background: var(--bg-deep);
  }
  .half {
    position: relative;
    overflow: hidden;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 110px 36px 90px;
    transition: flex 0.35s ease;
  }
  @media (min-width: 901px) {
    .half:hover, .half:focus-within { flex: 1.18; }
  }
  .half-web { background: linear-gradient(135deg, #B81D8F 0%, #8B2FC9 52%, #4C1D95 100%); }
  .half-ict { background: linear-gradient(135deg, #0A1E3F 0%, #103A6E 55%, #0B4F8F 100%); border-left: 1px solid rgba(255,255,255,0.25); }
  .glow { position: absolute; border-radius: 50%; pointer-events: none; }
  .g1 { width: 520px; height: 520px; background: rgba(255,255,255,0.12); filter: blur(100px); top: -140px; left: -120px; }
  .g2 { width: 560px; height: 560px; background: rgba(14,165,233,0.28); filter: blur(110px); top: -160px; right: -140px; }
  .half-web::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255,255,255,0.14) 1px, transparent 1px);
    background-size: 26px 26px;
    opacity: 0.35;
    pointer-events: none;
  }
  .half-ict::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(125,211,252,0.09) 1px, transparent 1px), linear-gradient(90deg, rgba(125,211,252,0.09) 1px, transparent 1px);
    background-size: 44px 44px;
    opacity: 0.6;
    pointer-events: none;
  }
  .content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    max-width: 460px;
    text-align: center;
  }
  .pills { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
  .content h1 {
    font-size: clamp(34px, 4.5vw, 58px);
    font-weight: 800;
    letter-spacing: 3px;
    color: #fff;
  }
  .content p { font-size: 16.5px; color: rgba(255,255,255,0.92); }
  .discover {
    display: inline-flex;
    margin-top: 10px;
    padding: 15px 44px;
    border: 1.5px solid #fff;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    color: #fff;
  }
  .discover:hover { background: rgba(255,255,255,0.14); color: #fff; text-decoration: none; }
  .logo-chip {
    position: absolute;
    top: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(11,14,26,0.6);
    border: 1px solid rgba(217,169,106,0.5);
    border-radius: 999px;
    padding: 10px 22px;
    font-family: "Sora", sans-serif;
    font-weight: 700;
    font-size: 18px;
    z-index: 2;
  }
  .logo-chip .mark { color: var(--gold); }
  .logo-chip .name { letter-spacing: 2.5px; color: var(--gold-light); }
  .contact-line {
    position: absolute;
    bottom: 22px;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 12.5px;
    color: rgba(255,255,255,0.78);
    z-index: 2;
  }
  .contact-line a { color: rgba(255,255,255,0.9); }
  @media (max-width: 900px) {
    .split { flex-direction: column; }
    .half { padding: 90px 28px 70px; }
    .half-ict { border-left: none; border-top: 1px solid rgba(255,255,255,0.25); }
    .logo-chip { font-size: 15px; padding: 8px 18px; }
  }
</style>
