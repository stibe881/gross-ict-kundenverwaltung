---
import Base from "../layouts/Base.astro";

const faqs = [
  { q: "Wie schnell können Sie bei einem Ausfall helfen?", a: "Bei kritischen Ausfällen (Server down, Netzwerk weg) reagieren wir während der Geschäftszeiten in der Regel innert 1-2 Stunden. Per Fernwartung oft noch schneller." },
  { q: "Arbeiten Sie mit einem Ticket-System?", a: "Ja, für die interne Nachverfolgung. Sie müssen sich aber in keinem Portal einloggen - ein einfacher Anruf oder eine E-Mail reicht, und wir kümmern uns um den Rest." },
  { q: "Bieten Sie auch Support ausserhalb der Geschäftszeiten?", a: "Standard-Supportzeiten sind Mo-Fr 08:00 - 17:30 Uhr. Für Server-Wartungen oder kritische Updates arbeiten wir nach Absprache auch am Wochenende oder abends." },
  { q: "Kann ich als Nicht-Kunde Hilfe anfordern?", a: "Selbstverständlich. Wir helfen auch im Notfall bei Umgebungen, die wir nicht selbst aufgebaut haben. Die Abrechnung erfolgt in diesem Fall nach Aufwand." }
];

const downloads = [
  { name: "Windows", desc: "Für Windows 10/11", url: "/Downloads/Support/GrossICT-Support.exe", icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>`, color: "rgba(255,255,255,0.1)" },
  { name: "macOS", desc: "Für macOS 12+", url: "https://anydesk.com/de/downloads/thank-you?dv=mac_dmg", icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><rect x="2" y="4" width="20" height="12" rx="2"></rect><path d="M12 16v4"></path><path d="M8 20h8"></path></svg>`, color: "rgba(255,255,255,0.1)" },
  { name: "iOS", desc: "Für iPhone & iPad", url: "https://apps.apple.com/app/anydesk-remote-desktop/id1176131273", icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M12 20.94c1.5 0 2.75 1.06 4 1.06 3 0 6-8 6-12.22A4.91 4.91 0 0 0 17 5c-2.22 0-4 1.44-5 2-1-.56-2.78-2-5-2a4.9 4.9 0 0 0-5 4.78C2 14 5 22 8 22c1.25 0 2.5-1.06 4-1.06Z"></path><path d="M10 2c1 .5 2 2 2 5"></path></svg>`, color: "rgba(255,255,255,0.1)" },
  { name: "Android", desc: "Für Android-Geräte", url: "https://play.google.com/store/apps/details?id=com.anydesk.anydeskandroid", icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M17 14v1a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2v-1"></path><path d="M12 5V2"></path><path d="M8.2 4.2l-1.4-1.4"></path><path d="M15.8 4.2l1.4-1.4"></path><circle cx="12" cy="10" r="4"></circle></svg>`, color: "rgba(255,255,255,0.1)" }
];
---
<Base title="Support & Helpdesk — Gross ICT" description="Schneller IT-Support. Ticket erstellen oder Remote-Support herunterladen." active="support">
  
  <style>
    .sup-grid { display: grid; grid-template-columns: 1fr 1fr; column-gap: 60px; align-items: start; }
    .sup-head { grid-column: 1; grid-row: 1; }
    .sup-form { grid-column: 1; grid-row: 2; }
    /* Label: 13px * 1.65 Zeilenhoehe + 5px Abstand -> Kacheln starten auf Hoehe der Oberkante des ersten Feldes */
    .sup-cards { grid-column: 2; grid-row: 2; margin-top: 26px; }
    @media (max-width: 860px) {
      .sup-grid { grid-template-columns: 1fr; }
      .sup-head, .sup-form, .sup-cards { grid-column: 1; }
      .sup-head { grid-row: 1; } .sup-form { grid-row: 2; } .sup-cards { grid-row: 3; margin-top: 40px; }
    }
    .status-line { margin-top: 32px; display: flex; align-items: center; flex-wrap: wrap; gap: 14px; font-size: 14.5px; color: var(--text); }
    .status-dot { width: 10px; height: 10px; border-radius: 50%; background: #4ADE80; box-shadow: 0 0 0 4px rgba(74,222,128,0.2); }
    .status-line strong { font-weight: 700; }
    .status-sep { width: 1px; height: 16px; background: var(--line); }
    .status-hours { color: var(--muted); font-weight: 500; }

    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
    @media (max-width: 640px) { .form-grid { grid-template-columns: 1fr; } }
    
    .contact-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; padding: 60px 0 80px; }
    @media (max-width: 820px) { .contact-cards { grid-template-columns: 1fr; } }
    .ccard { background: var(--panel-2); border: 1px solid var(--line); border-radius: 16px; padding: 32px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 16px; box-shadow: 0 4px 24px rgba(0,0,0,0.1); transition: all 0.2s; }
    .ccard:hover { border-color: var(--gold); transform: translateY(-4px); box-shadow: 0 12px 30px rgba(0,0,0,0.15); }
    .ccard .icon { width: 56px; height: 56px; border-radius: 50%; background: var(--bg); border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; color: var(--gold); }
    .ccard p.label { font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--muted); margin: 0; }
    .ccard p.val { font-size: 18px; font-weight: 700; color: var(--text); margin: 0; }
    
    .faq-section { margin-top: 72px; padding: 80px 0; border-top: 1px solid var(--line); }
    .faq-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 40px; gap: 40px; }
    @media (max-width: 820px) { .faq-header { flex-direction: column; align-items: flex-start; gap: 16px; } }
    .faq-title { font-size: clamp(36px, 5vw, 54px); line-height: 1.1; margin: 0; max-width: 500px; }
    .faq-desc { font-size: 16px; color: var(--muted); max-width: 320px; margin: 0; }
    
    .faq-list { display: flex; flex-direction: column; }
    .faq-item { background: var(--panel-2); border: 1px solid var(--line); border-radius: 12px; padding: 24px 32px; margin-bottom: 12px; cursor: pointer; transition: all 0.2s; overflow: hidden; }
    .faq-item:hover { border-color: var(--gold); }
    .faq-item-header { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
    .faq-item h3 { font-size: 16px; font-family: "Manrope", sans-serif; font-weight: 600; color: var(--text); margin: 0; }
    .faq-item .plus { color: var(--gold); font-size: 24px; font-weight: 300; line-height: 1; transition: transform 0.2s; }
    .faq-answer { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.3s ease; }
    .faq-answer p { overflow: hidden; color: var(--muted); font-size: 15px; margin: 0; line-height: 1.6; }
    .faq-item.open .faq-answer { grid-template-rows: 1fr; }
    .faq-item.open .faq-answer p { padding-top: 16px; }
    .faq-item.open .plus { transform: rotate(45deg); }
    
    .downloads-section { padding: 40px 0 100px; border-top: 1px solid var(--line); }
    .dl-header { margin-bottom: 40px; display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; }
    @media (max-width: 768px) { .dl-header { flex-direction: column; align-items: flex-start; } }
    .dl-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; }
    .dl-card { background: var(--panel-2); border: 1px solid var(--line); border-radius: 16px; padding: 32px 24px; text-decoration: none; transition: all 0.2s; display: flex; flex-direction: column; align-items: center; text-align: center; }
    .dl-card:hover { transform: translateY(-4px); border-color: var(--gold); box-shadow: 0 12px 30px rgba(0,0,0,0.1); }
    .dl-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 24px; background: var(--gold); }
    .dl-icon svg { stroke: #221A0E; }
    .dl-card h3 { font-family: "Manrope", sans-serif; font-size: 20px; font-weight: 700; color: var(--text); margin: 0 0 8px; }
    .dl-card p { font-size: 14px; color: var(--muted); margin: 0 0 24px; }
    .dl-btn { font-size: 13.5px; font-weight: 700; color: var(--text); background: var(--bg); padding: 10px 20px; border-radius: 99px; display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--line); }
  </style>

  <div class="page-header" style="padding: 120px 24px 60px; max-width: 1240px; margin: 0 auto;">
    <p class="mono">Support & Helpdesk</p>
    <h1 class="anton anton-title" style="margin-top: 14px">Wir helfen.<br/><span style="color: var(--gold); font-style: italic;">Schnell.</span></h1>
    <p style="color: var(--muted); font-size: 18px; margin-top: 16px; max-width: 600px;">
      Telefon, E-Mail, Remote oder Vor-Ort. Sie sagen uns, wo es brennt — wir sind sofort dran. Ohne Warteschleife, ohne Tickets, die im Nirgendwo verschwinden.
    </p>
    <div class="status-line">
      <span class="status-dot" id="status-dot" aria-hidden="true"></span>
      <strong id="status-text">Service betriebsbereit</strong>
      <span class="status-sep" aria-hidden="true"></span>
      <span class="status-hours">Mo-Fr 08:00-17:30</span>
    </div>
    <script>
      // Ampel: grün während der Arbeitszeiten (Mo–Fr 08:00–17:30 Schweizer Zeit), sonst orange
      const parts = new Intl.DateTimeFormat("de-CH", {
        timeZone: "Europe/Zurich", weekday: "short", hour: "numeric", minute: "numeric", hour12: false,
      }).formatToParts(new Date());
      const get = (t: string) => parts.find((p) => p.type === t)?.value || "";
      const wochentag = get("weekday");
      const minuten = Number(get("hour")) * 60 + Number(get("minute"));
      const offen = !["Sa", "So"].includes(wochentag) && minuten >= 8 * 60 && minuten < 17 * 60 + 30;
      if (!offen) {
        const dot = document.getElementById("status-dot");
        const text = document.getElementById("status-text");
        if (dot) { dot.style.background = "#F59E0B"; dot.style.boxShadow = "0 0 0 4px rgba(245,158,11,0.2)"; }
        if (text) text.textContent = "Zurzeit nicht besetzt";
      }
    </script>
  </div>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="sup-grid">
        <div class="sup-head">
          <h2 class="anton" style="font-size: 32px; margin-bottom: 16px; letter-spacing: 0.5px;">Support-Ticket erstellen</h2>
          <p style="color: var(--muted); font-size: 16px; margin-bottom: 24px;">Schildern Sie uns Ihr Problem kurz, wir melden uns umgehend bei Ihnen.</p>
        </div>
        <div class="sup-form">
          
          <form id="support-form">
            <div class="form-grid">
              <div>
                <label>Firma</label>
                <input type="text" name="company" />
              </div>
              <div>
                <label>Anrede *</label>
                <select name="salutation" required>
                  <option value="">Bitte wählen</option>
                  <option value="Frau">Frau</option>
                  <option value="Herr">Herr</option>
                </select>
              </div>
            </div>
            <div class="form-grid">
              <div>
                <label>Vorname *</label>
                <input type="text" name="firstname" required />
              </div>
              <div>
                <label>Nachname *</label>
                <input type="text" name="lastname" required />
              </div>
            </div>
            <div class="form-grid">
              <div>
                <label>Telefon</label>
                <input type="tel" name="phone" />
              </div>
              <div>
                <label>E-Mail *</label>
                <input type="email" name="email" required />
              </div>
            </div>
            <div style="margin-bottom: 16px;">
              <label>Problembeschreibung *</label>
              <textarea name="message" rows="4" required></textarea>
            </div>
            <div style="display: flex; gap: 12px; align-items: flex-start; margin-bottom: 24px;">
              <input type="checkbox" id="dsgvo" required style="margin-top: 4px; width: 16px; height: 16px; accent-color: var(--gold);" />
              <label for="dsgvo" style="font-size: 13.5px; color: var(--muted); font-weight: 400; line-height: 1.5; margin: 0;">Ich habe die <a href="/datenschutz" style="text-decoration: underline; color: var(--text);">Datenschutzerklärung</a> gelesen und bin einverstanden.</label>
            </div>
            <button type="submit" class="btn" style="background: var(--gold); color: #2C2621; width: 100%;">
              Ticket erstellen 
            </button>
            <p id="support-status" style="margin-top: 12px; font-weight: 600; font-size: 14px; display: none;"></p>
          </form>
        </div>
        
        <div class="sup-cards">
          <div class="contact-cards" style="padding: 0; display: flex; flex-direction: column; gap: 24px;">
            <a href="tel:+41415623416" class="ccard" style="flex-direction: row; text-align: left; padding: 24px; text-decoration: none;">
              <div class="icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              </div>
              <div>
                <p class="label">Telefon</p>
                <p class="val">+41 41 562 34 16</p>
              </div>
            </a>
            <a href="mailto:support@gross-ict.ch" class="ccard" style="flex-direction: row; text-align: left; padding: 24px; text-decoration: none;">
              <div class="icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              </div>
              <div>
                <p class="label">Support-E-Mail</p>
                <p class="val">support@gross-ict.ch</p>
              </div>
            </a>
            <a href="https://maps.google.com/?q=Neuhushof+3,+6144+Zell" target="_blank" rel="noopener" class="ccard" style="flex-direction: row; text-align: left; padding: 24px; text-decoration: none;">
              <div class="icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              </div>
              <div>
                <p class="label">Standort</p>
                <p class="val">Neuhushof 3, 6144 Zell</p>
              </div>
            </a>
          </div>
        </div>
      </div>

      <section class="faq-section">
        <div class="faq-header">
          <div>
            <p class="mono" style="letter-spacing: 2px;">HÄUFIG GEFRAGT</p>
            <h2 class="anton faq-title">Antworten auf<br/><span style="color: var(--gold); font-style: italic;">die wichtigsten</span><br/>Fragen.</h2>
          </div>
          <p class="faq-desc">Etwas nicht dabei? Greifen Sie zum Hörer — wir antworten lieber persönlich.</p>
        </div>
        <div class="faq-list">
          {faqs.map(faq => (
            <div class="faq-item" onclick="this.classList.toggle('open')">
              <div class="faq-item-header">
                <h3>{faq.q}</h3>
                <span class="plus">+</span>
              </div>
              <div class="faq-answer">
                <p>{faq.a}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="downloads-section">
        <div class="dl-header">
          <h2 class="anton" style="font-size: clamp(32px, 4vw, 48px); line-height: 1.1; max-width: 400px; color: var(--text);">Remote-Support herunterladen</h2>
          <p style="color: var(--muted); max-width: 400px; margin: 0; font-size: 15px;">Für eine schnelle und sichere Fernwartung benötigen Sie unsere Support-Software. Wählen Sie die Version für Ihr Betriebssystem.</p>
        </div>
        <div class="dl-grid">
          {downloads.map(dl => (
            <a href={dl.url} class="dl-card" target="_blank" rel="noopener">
              <div class="dl-icon">
                <Fragment set:html={dl.icon} />
              </div>
              <h3>{dl.name}</h3>
              <p>{dl.desc}</p>
              <div class="dl-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                Herunterladen
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>
  </section>

  <script>
    const form = document.getElementById('support-form') as HTMLFormElement;
    const status = document.getElementById('support-status');
    if (form && status) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        status.style.display = 'block';
        status.style.color = 'var(--muted)';
        status.textContent = 'Wird gesendet...';
        
        const fd = new FormData(form);
        const data = Object.fromEntries(fd.entries());
        try {
          const res = await fetch("https://bvluvvyvftygnxtmboxw.supabase.co/functions/v1/contact-form", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              name: `${data.firstname} ${data.lastname}`,
              email: data.email,
              phone: data.phone,
              company: data.company,
              message: `[SUPPORT-TICKET]\nAnrede: ${data.salutation}\n\nProblem:\n${data.message}`
            })
          });
          if (!res.ok) throw new Error();
          status.style.color = '#4ADE80';
          status.textContent = 'Ticket erfolgreich erstellt. Wir melden uns in Kürze!';
          form.reset();
        } catch {
          status.style.color = '#F87171';
          status.textContent = 'Fehler beim Senden. Bitte rufen Sie uns an.';
        }
      });
    }
  </script>
</Base>
